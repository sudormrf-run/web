---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const locale = 'ko';
const { t } = useTranslations(locale);

// Get all AI news for Korean
const allNews = await getCollection('ainews', ({ slug }) => slug.startsWith('ko/'));

// Sort by date (newest first)
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Separate featured and regular news
const featuredNews = sortedNews.filter((news) => news.data.isFeatured);
const regularNews = sortedNews.filter((news) => !news.data.isFeatured);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="AI 뉴스" locale={locale}>
  <div class="news-page">
    <div class="container">
      <!-- Header -->
      <header class="page-header">
        <h1 class="page-title">
          <span class="gradient-text">AI 뉴스</span>
        </h1>
        <p class="page-subtitle">
          smol.ai AI 뉴스의 한국어 번역
        </p>
      </header>

      <!-- Featured News -->
      {featuredNews.length > 0 && (
        <section class="news-section featured-section">
          <h2 class="section-title">
            <span class="title-icon featured-icon">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
              </svg>
            </span>
            주요 뉴스
          </h2>
          <div class="featured-grid">
            {featuredNews.map((news) => (
              <a href={`/news/${news.slug.replace('ko/', '')}`} class="featured-card">
                <div class="featured-header">
                  <span class="news-badge featured-badge">주요</span>
                  <span class="news-date">{formatDate(news.data.date)}</span>
                </div>
                <h3 class="featured-title">{news.data.title}</h3>
                {news.data.hasHeadline && news.data.headline && (
                  <p class="featured-headline">{news.data.headline}</p>
                )}
                <ul class="summary-list">
                  {news.data.summary.slice(0, 3).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {news.data.tags && news.data.tags.length > 0 && (
                  <div class="news-tags">
                    {news.data.tags.slice(0, 4).map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- All News -->
      <section class="news-section">
        <h2 class="section-title">
          <span class="title-icon news-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2" />
            </svg>
          </span>
          전체 뉴스
        </h2>
        <div class="news-grid">
          {sortedNews.map((news) => (
            <a href={`/news/${news.slug.replace('ko/', '')}`} class="news-card">
              <div class="news-header">
                {news.data.hasHeadline && <span class="news-badge headline-badge">헤드라인</span>}
                <span class="news-date">{formatDate(news.data.date)}</span>
              </div>
              <h3 class="news-title">{news.data.title}</h3>
              <ul class="summary-preview">
                {news.data.summary.slice(0, 2).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {news.data.tags && news.data.tags.length > 0 && (
                <div class="news-tags">
                  {news.data.tags.slice(0, 3).map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>

      {allNews.length === 0 && (
        <div class="no-news">
          <p>아직 등록된 뉴스가 없습니다.</p>
        </div>
      )}

      <!-- Source Attribution -->
      <footer class="source-attribution">
        <p>
          뉴스 출처:
          <a href="https://news.smol.ai" target="_blank" rel="noopener noreferrer">
            smol.ai AI News
            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .news-page {
    padding: 2rem 0 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Sections */
  .news-section {
    margin-bottom: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .title-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
  }

  .featured-icon {
    background: rgba(253, 115, 24, 0.15);
    color: var(--color-accent);
  }

  .news-icon {
    background: rgba(95, 173, 254, 0.15);
    color: var(--color-blue);
  }

  /* Featured Grid */
  .featured-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-card {
    background: var(--color-surface);
    border: 1px solid rgba(253, 115, 24, 0.4);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .featured-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-green));
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.2),
      0 0 20px rgba(253, 115, 24, 0.15);
  }

  .featured-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .featured-headline {
    font-size: 0.9rem;
    color: var(--color-accent);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  /* News Grid */
  .news-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .news-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .news-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .news-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .featured-badge {
    background: rgba(253, 115, 24, 0.2);
    color: var(--color-accent);
  }

  .headline-badge {
    background: rgba(67, 214, 168, 0.2);
    color: var(--color-green);
  }

  .news-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: auto;
  }

  .news-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Summary Lists */
  .summary-list,
  .summary-preview {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .summary-list li,
  .summary-preview li {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .summary-list li::before,
  .summary-preview li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .summary-preview li {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags */
  .news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    padding: 0.15rem 0.5rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .no-news {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
  }

  /* Source Attribution */
  .source-attribution {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .source-attribution p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .source-attribution a {
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .source-attribution a:hover {
    text-decoration: underline;
  }
</style>
