---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const locale = 'ko';
const { t } = useTranslations(locale);

// Get all AI news for Korean
const allNews = await getCollection('ainews', ({ slug }) => slug.startsWith('ko/'));

// Sort by date (newest first)
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="AI 데일리 뉴스" locale={locale}>
  <div class="news-page">
    <div class="container">
      <!-- Header -->
      <header class="page-header">
        <h1 class="page-title">
          <span class="gradient-text">AI 데일리 뉴스</span>
        </h1>
        <p class="page-subtitle">
          smol.ai AI 뉴스 한국어 번역
        </p>
      </header>

      <!-- News List -->
      <div class="news-list">
        {sortedNews.map((news) => (
          <a href={`/news/${news.slug.replace('ko/', '')}`} class="news-card">
            <div class="news-header">
              <span class="news-date">{formatDate(news.data.date)}</span>
              {news.data.hasHeadline && <span class="news-badge">헤드라인</span>}
            </div>
            <h2 class="news-title">{news.data.title}</h2>
            <ul class="news-summary">
              {news.data.summary.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {news.data.tags && news.data.tags.length > 0 && (
              <div class="news-tags">
                {news.data.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>

      {allNews.length === 0 && (
        <div class="no-news">
          <p>아직 등록된 뉴스가 없습니다.</p>
        </div>
      )}

      <!-- Source Attribution -->
      <footer class="source-attribution">
        <p>
          뉴스 출처:
          <a href="https://news.smol.ai" target="_blank" rel="noopener noreferrer">
            smol.ai AI News
            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .news-page {
    padding: 2rem 0 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* News List */
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .news-card {
    background: var(--color-surface);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .news-card:hover {
    transform: translateY(-2px);
    border-color: #a855f7;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.2),
      0 0 12px rgba(168, 85, 247, 0.2);
  }

  .news-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .news-date {
    font-size: 0.85rem;
    color: #a855f7;
    font-weight: 600;
  }

  .news-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(67, 214, 168, 0.2);
    color: var(--color-green);
  }

  .news-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .news-summary {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .news-summary li {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    padding-left: 1.25rem;
    position: relative;
  }

  .news-summary li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: #a855f7;
    border-radius: 50%;
  }

  .news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .no-news {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
  }

  /* Source Attribution */
  .source-attribution {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .source-attribution p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .source-attribution a {
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .source-attribution a:hover {
    text-decoration: underline;
  }
</style>
