---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const locale = 'ko';
const { t } = useTranslations(locale);

// Fetch archive items (자료 창고)
const archiveItems = await getCollection('archive', ({ slug }) =>
  slug.startsWith('ko/')
);
const sortedArchive = archiveItems.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
).slice(0, 3); // Show only 3 latest items

// Fetch AI news items (자동 발행 뉴스)
const ainewsItems = await getCollection('ainews', ({ slug }) =>
  slug.startsWith('ko/')
);
const sortedNews = ainewsItems.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
).slice(0, 3); // Show only 3 latest items

// Fetch podcast episodes (팟캐스트 라이브러리)
const podcastItems = await getCollection('podcasts', ({ slug, data }) =>
  slug.startsWith('ko/') && !data.isDraft
);
const sortedPodcasts = podcastItems.sort((a, b) => {
  const episodeDiff = (b.data.episodeNumber ?? 0) - (a.data.episodeNumber ?? 0);
  if (episodeDiff !== 0) return episodeDiff;
  return b.data.date.getTime() - a.data.date.getTime();
});
const featuredPodcasts = sortedPodcasts.filter((item) => item.data.isFeatured).slice(0, 2);
const latestPodcasts = (featuredPodcasts.length > 0 ? featuredPodcasts : sortedPodcasts).slice(0, 2);
const leadPodcast = latestPodcasts[0];
const secondaryPodcasts = sortedPodcasts.filter((item) => item.id !== leadPodcast?.id).slice(0, 2);
const podcastTags = [...new Set(sortedPodcasts.flatMap((item) => item.data.tags ?? []))].slice(0, 8);
const podcastChapterCount = sortedPodcasts.reduce((sum, item) => sum + (item.data.chapters?.length ?? 0), 0);
const podcastResourceCount = sortedPodcasts.reduce(
  (sum, item) => sum + (item.data.resources?.length ?? 0) + (item.data.relatedLinks?.length ?? 0),
  0
);
const getPodcastSlug = (slug: string) => slug.replace('ko/', '');
const getPodcastThumbnail = (item: (typeof sortedPodcasts)[number]) =>
  item.data.thumbnail ?? `https://img.youtube.com/vi/${item.data.videoId}/hqdefault.jpg`;

// YouTube & Social Links
const youtubeChannel = 'https://www.youtube.com/@sudoremove';
const instagramUrl = 'https://www.instagram.com/sudo.remove/';

// Essays & Columns data
const essays = [
  {
    title: '허깅페이스 르로봇 해커톤 후기',
    description: '허깅페이스의 르로봇 월드와이드 해커톤 서울 행사를 주최하며 경험한 과정과 결과',
    author: '박종현',
    date: '2025-06-24',
    link: 'https://sudormrf.run/2025/06/24/huggingface-lerobot-hackathon-review/',
    isExternal: true,
  },
];

// Presentations data
const presentations = [
  {
    title: 'VLA, Physical AI의 실현',
    speaker: '조준호',
    event: 'Physical AI Workshop',
    date: '2025-08-14',
    link: 'https://sudormrf-run.github.io/community/slides/20250814_vla_talk.pdf',
    type: 'pdf',
  },
  {
    title: 'HuggingFace의 Action Data Scaling',
    speaker: '박종현',
    event: 'AI Robotics Korea',
    date: '2025-08-15',
    link: 'https://jonhpark7966.github.io/public-slides/250815_airk',
    type: 'web',
  },
  {
    title: 'LLM 파인튜닝',
    speaker: '박종현',
    event: '교육 자료',
    date: '2024',
    link: 'https://github.com/jonhpark7966/public-slides/blob/main/250801_LLMFineTuning/LLM_FineTuning_250804.pdf',
    type: 'pdf',
  },
];
---

<Layout title={t('media.title')} locale={locale}>
  <div class="media-page">
    <div class="container">
      <!-- Header -->
      <header class="page-header">
        <h1 class="page-title">
          <span class="gradient-text">{t('media.title')}</span>
        </h1>
        <p class="page-subtitle">
          {t('media.subtitle')}
        </p>

        <!-- Social Links -->
        <div class="social-links">
          <a href={youtubeChannel} target="_blank" rel="noopener noreferrer" class="social-btn youtube">
            <div class="youtube-btn-content">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" />
                <path fill="var(--color-bg-primary)" d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
              <span class="youtube-btn-text">
                <span class="youtube-btn-main">{t('media.subscribe')}</span>
                <span class="youtube-btn-sub">매주 일요일 라이브 진행</span>
              </span>
            </div>
            <span class="live-indicator">
              <span class="live-dot"></span>
              LIVE
            </span>
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="social-btn instagram">
            <div class="instagram-btn-content">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="instagram-btn-text">
                <span class="instagram-btn-main">{t('media.follow')}</span>
                <span class="instagram-btn-sub">최신 AI 뉴스 릴스</span>
              </span>
            </div>
          </a>
        </div>
      </header>

      <!-- Featured Podcast Hero -->
      {leadPodcast && (
        <section class="featured-podcast-hero" aria-labelledby="featured-podcast-hero-title">
          <div class="featured-podcast-copy">
            <div class="hero-kicker">SUDO REMOVE PODCAST</div>
            <h2 id="featured-podcast-hero-title">
              AI와 로보틱스를 영상 단위로 다시 찾는
              <span>연구 라이브러리</span>
            </h2>
            <p>
              팟캐스트를 단순 재생목록이 아니라 요약, 챕터, 참고자료, 태그로 연결된
              지식 아카이브로 정리합니다. 궁금한 주제를 검색하고, 관련 링크를 따라가며,
              에피소드별 맥락을 빠르게 복습하세요.
            </p>

            <div class="podcast-hero-actions">
              <a href="/podcasts/" class="primary-podcast-cta">팟캐스트 라이브러리 열기</a>
              <a href={`/podcasts/${getPodcastSlug(leadPodcast.slug)}/`} class="secondary-podcast-cta">최신 에피소드 보기</a>
            </div>

            <div class="podcast-hero-metrics" aria-label="팟캐스트 라이브러리 통계">
              <div><strong>{sortedPodcasts.length}</strong><span>Episodes</span></div>
              <div><strong>{podcastTags.length}</strong><span>Tags</span></div>
              <div><strong>{podcastChapterCount}</strong><span>Chapters</span></div>
              <div><strong>{podcastResourceCount}</strong><span>References</span></div>
            </div>

            {podcastTags.length > 0 && (
              <div class="podcast-hero-tags" aria-label="대표 팟캐스트 태그">
                {podcastTags.map((tag) => <span>#{tag}</span>)}
              </div>
            )}
          </div>

          <div class="featured-podcast-panel">
            <a href={`/podcasts/${getPodcastSlug(leadPodcast.slug)}/`} class="featured-episode-hero-card">
              <div class="featured-episode-thumbnail">
                <img src={getPodcastThumbnail(leadPodcast)} alt={`${leadPodcast.data.title} 썸네일`} loading="eager" />
                {leadPodcast.data.duration && <span>{leadPodcast.data.duration}</span>}
              </div>
              <div class="featured-episode-content">
                <span class="featured-episode-label">Featured Episode</span>
                <div class="featured-episode-meta">
                  {leadPodcast.data.episodeNumber && <span>EP.{leadPodcast.data.episodeNumber}</span>}
                  <time datetime={leadPodcast.data.date.toISOString()}>
                    {leadPodcast.data.date.toISOString().split('T')[0]}
                  </time>
                </div>
                <h3>{leadPodcast.data.title}</h3>
                <p>{leadPodcast.data.summary?.[0] ?? leadPodcast.data.description}</p>
              </div>
            </a>

            {secondaryPodcasts.length > 0 && (
              <div class="recent-podcast-hero-list">
                <div class="recent-podcast-title">최근 에피소드</div>
                {secondaryPodcasts.map((item) => (
                  <a href={`/podcasts/${getPodcastSlug(item.slug)}/`} class="recent-podcast-hero-link">
                    <span>{item.data.episodeNumber ? `EP.${item.data.episodeNumber}` : 'Podcast'}</span>
                    <strong>{item.data.title}</strong>
                  </a>
                ))}
              </div>
            )}
          </div>
        </section>
      )}

      <!-- AI 데일리 뉴스 Section -->
      <section class="media-section">
        <div class="section-header">
          <div class="section-title-wrapper">
            <span class="section-icon ainews-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </span>
            <div>
              <h2 class="section-title">{t('media.news.title')}</h2>
              <p class="section-description">{t('media.news.description')}</p>
            </div>
          </div>
          <a href="/news" class="view-all-link ainews-view-all">
            전체 보기 →
          </a>
        </div>
        <div class="ainews-grid">
          {sortedNews.length > 0 ? (
            sortedNews.map((item) => {
              const slug = item.slug.replace('ko/', '');
              return (
                <a href={`/news/${slug}`} class="ainews-card">
                  <div class="ainews-card-content">
                    <div class="ainews-meta">
                      {item.data.hasHeadline && <span class="ainews-headline-badge">헤드라인</span>}
                      <span class="ainews-date">{item.data.date.toISOString().split('T')[0]}</span>
                    </div>
                    <h3 class="ainews-title">{item.data.title}</h3>
                    <ul class="ainews-summary">
                      {item.data.summary.slice(0, 2).map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                    {item.data.tags && item.data.tags.length > 0 && (
                      <div class="ainews-tags">
                        {item.data.tags.slice(0, 3).map((tag) => (
                          <span class="ainews-tag">#{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })
          ) : (
            <div class="ainews-empty">
              <p>아직 등록된 뉴스가 없습니다.</p>
            </div>
          )}
        </div>
      </section>

      <!-- Presentations Section -->
      <section class="media-section">
        <div class="section-header">
          <div class="section-title-wrapper">
            <span class="section-icon presentations-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
              </svg>
            </span>
            <div>
              <h2 class="section-title">{t('media.presentations.title')}</h2>
              <p class="section-description">{t('media.presentations.description')}</p>
            </div>
          </div>
        </div>
        <div class="presentations-scroll">
          <div class="presentations-track">
            {presentations.map((pres) => (
              <a href={pres.link} target="_blank" rel="noopener noreferrer" class="presentation-card">
                <div class="presentation-icon-wrapper">
                  {pres.type === 'pdf' ? (
                    <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v6a1 1 0 001 1h6"/>
                    </svg>
                  ) : (
                    <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  )}
                  <span class="presentation-type-badge">{pres.type === 'pdf' ? 'PDF' : 'WEB'}</span>
                </div>
                <div class="presentation-info">
                  <span class="presentation-event">{pres.event}</span>
                  <h3 class="presentation-title">{pres.title}</h3>
                  <span class="presentation-speaker">{pres.speaker}</span>
                  <span class="presentation-date">{pres.date}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 자료 창고 Section -->
      <section class="media-section">
        <div class="section-header">
          <div class="section-title-wrapper">
            <span class="section-icon archive-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </span>
            <div>
              <h2 class="section-title">자료 창고</h2>
              <p class="section-description">수도리무브 큐레이션, 우리가 보는 양질의 영상들</p>
            </div>
          </div>
          <a href="/archive" class="view-all-link archive-view-all">
            전체 보기 →
          </a>
        </div>
        <div class="archive-grid">
          {sortedArchive.length > 0 ? (
            sortedArchive.map((item) => {
              const slug = item.slug.replace('ko/', '');
              return (
                <a href={`/archive/${slug}`} class="archive-card">
                  <div class="archive-card-content">
                    <div class="archive-meta">
                      <span class="archive-source">{item.data.source}</span>
                      <span class="archive-date">{item.data.date.toISOString().split('T')[0]}</span>
                    </div>
                    <h3 class="archive-title">{item.data.title}</h3>
                    <p class="archive-summary">{item.data.description.split('\n')[0].replace(/^\d+\.\s*/, '')}</p>
                    <div class="archive-footer">
                      <span class="archive-duration">
                        <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        {item.data.duration}
                      </span>
                      <span class="archive-chapters">
                        {item.data.chapters?.length || 0} chapters
                      </span>
                    </div>
                  </div>
                </a>
              );
            })
          ) : (
            <div class="archive-empty">
              <p>콘텐츠 준비 중...</p>
            </div>
          )}
        </div>
      </section>

      <!-- Essays & Columns Section -->
      <section class="media-section">
        <div class="section-header">
          <div class="section-title-wrapper">
            <span class="section-icon essays-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
            </span>
            <div>
              <h2 class="section-title">{t('media.essays.title')}</h2>
              <p class="section-description">{t('media.essays.description')}</p>
            </div>
          </div>
        </div>
        <div class="essays-grid">
          {essays.map((essay) => (
            <a href={essay.link} target={essay.isExternal ? "_blank" : undefined} rel={essay.isExternal ? "noopener noreferrer" : undefined} class="essay-card">
              <div class="essay-content">
                <h3 class="essay-title">{essay.title}</h3>
                <p class="essay-description">{essay.description}</p>
                <div class="essay-meta">
                  <span class="essay-author">{essay.author}</span>
                  <span class="essay-date">{essay.date}</span>
                  {essay.isExternal && (
                    <span class="essay-external">
                      <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- AI News Playlist Section -->
      <section class="media-section">
        <div class="section-header">
          <div class="section-title-wrapper">
            <span class="section-icon podcast-icon">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23h2v-2.06A9 9 0 0 0 21 12v-2h-2z"/>
              </svg>
            </span>
            <div>
              <h2 class="section-title">AI 뉴스</h2>
              <p class="section-description">AI와 로보틱스 최신 소식을 영상으로 확인하세요</p>
            </div>
          </div>
          <a href="https://www.youtube.com/playlist?list=PLLYXs4EFjbmkqbBE7mskK9Uq7DwaCl8KL" target="_blank" rel="noopener noreferrer" class="view-all-link podcast-view-all">
            AI 뉴스 재생목록 보기 →
          </a>
        </div>
        <div class="podcast-grid ai-news-only-grid">
          <a href="https://www.youtube.com/playlist?list=PLLYXs4EFjbmkqbBE7mskK9Uq7DwaCl8KL" target="_blank" rel="noopener noreferrer" class="podcast-embed-card news">
            <div class="podcast-embed-wrapper">
              <iframe
                src="https://www.youtube.com/embed/videoseries?list=PLLYXs4EFjbmkqbBE7mskK9Uq7DwaCl8KL"
                title="AI 최신 뉴스 재생목록"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <div class="podcast-embed-info">
              <h3 class="podcast-embed-title">AI 최신 뉴스</h3>
              <p class="podcast-embed-description">AI와 로보틱스 최신 소식</p>
            </div>
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .media-page {
    padding: 2rem 0 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-btn.youtube {
    background: linear-gradient(135deg, #ff0000 0%, #cc0000 100%);
    color: white;
    padding: 0.5rem 1rem;
    gap: 0.75rem;
  }

  .social-btn.youtube:hover {
    background: linear-gradient(135deg, #cc0000 0%, #aa0000 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(255, 0, 0, 0.5);
  }

  .youtube-btn-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .youtube-btn-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .youtube-btn-main {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .youtube-btn-sub {
    font-size: 0.7rem;
    opacity: 0.9;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .social-btn.instagram {
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: white;
    padding: 0.5rem 1rem;
  }

  .social-btn.instagram:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(225, 48, 108, 0.5);
  }

  .instagram-btn-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .instagram-btn-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .instagram-btn-main {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .instagram-btn-sub {
    font-size: 0.7rem;
    opacity: 0.9;
  }

  .featured-podcast-hero {
    position: relative;
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgba(67, 214, 168, 0.28);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 12% 18%, rgba(67, 214, 168, 0.22), transparent 28%),
      radial-gradient(circle at 86% 8%, rgba(253, 115, 24, 0.14), transparent 24%),
      linear-gradient(135deg, rgba(17, 8, 17, 0.98), rgba(12, 18, 18, 0.96));
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .featured-podcast-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(67, 214, 168, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(67, 214, 168, 0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(135deg, black, transparent 72%);
    pointer-events: none;
  }

  @media (min-width: 980px) {
    .featured-podcast-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.8fr);
      align-items: center;
    }
  }

  .featured-podcast-copy,
  .featured-podcast-panel {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(67, 214, 168, 0.35);
    border-radius: 999px;
    background: rgba(67, 214, 168, 0.1);
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
  }

  .featured-podcast-copy h2 {
    max-width: 760px;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 5vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .featured-podcast-copy h2 span {
    display: block;
    color: var(--color-green);
    text-shadow: 0 0 26px rgba(67, 214, 168, 0.22);
  }

  .featured-podcast-copy > p {
    max-width: 680px;
    color: var(--color-text-secondary);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .podcast-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .primary-podcast-cta,
  .secondary-podcast-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.78rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .primary-podcast-cta {
    background: linear-gradient(135deg, var(--color-green), #2fbf95);
    color: #06110f;
    box-shadow: 0 10px 28px rgba(67, 214, 168, 0.22);
  }

  .secondary-podcast-cta {
    border: 1px solid rgba(67, 214, 168, 0.35);
    background: rgba(67, 214, 168, 0.08);
    color: var(--color-green);
  }

  .primary-podcast-cta:hover,
  .secondary-podcast-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(67, 214, 168, 0.18);
  }

  .podcast-hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 620px;
  }

  @media (min-width: 640px) {
    .podcast-hero-metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .podcast-hero-metrics div {
    padding: 0.9rem;
    border: 1px solid rgba(67, 214, 168, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(7, 16, 16, 0.68);
  }

  .podcast-hero-metrics strong {
    display: block;
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1;
  }

  .podcast-hero-metrics span {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .podcast-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .podcast-hero-tags span {
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    background: rgba(253, 115, 24, 0.1);
    color: var(--color-accent-hover);
    font-size: 0.78rem;
  }

  .featured-podcast-panel {
    display: grid;
    gap: 0.9rem;
  }

  .featured-episode-hero-card {
    display: block;
    border: 1px solid rgba(67, 214, 168, 0.3);
    border-radius: var(--radius-xl);
    background: rgba(17, 8, 17, 0.78);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .featured-episode-hero-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-green);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.32), 0 0 24px rgba(67, 214, 168, 0.18);
  }

  .featured-episode-thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-secondary);
    overflow: hidden;
  }

  .featured-episode-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.22s ease;
  }

  .featured-episode-hero-card:hover .featured-episode-thumbnail img {
    transform: scale(1.035);
  }

  .featured-episode-thumbnail span {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.76);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .featured-episode-content {
    padding: 1.15rem;
  }

  .featured-episode-label {
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-episode-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.55rem 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .featured-episode-content h3 {
    color: var(--color-text-primary);
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.35;
    margin-bottom: 0.55rem;
  }

  .featured-episode-content p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .recent-podcast-hero-list {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid rgba(67, 214, 168, 0.18);
    border-radius: var(--radius-xl);
    background: rgba(7, 16, 16, 0.58);
  }

  .recent-podcast-title {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .recent-podcast-hero-link {
    display: grid;
    gap: 0.2rem;
    padding: 0.65rem;
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .recent-podcast-hero-link:hover {
    background: rgba(67, 214, 168, 0.08);
  }

  .recent-podcast-hero-link span {
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .recent-podcast-hero-link strong {
    color: var(--color-text-primary);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  /* Media Sections */
  .media-section {
    margin-bottom: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-title-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .section-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .podcast-icon {
    background: rgba(255, 0, 0, 0.15);
    color: #ff0000;
  }

  .essays-icon {
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
  }

  .presentations-icon {
    background: rgba(95, 173, 254, 0.15);
    color: var(--color-blue);
  }

  .news-icon {
    background: rgba(67, 214, 168, 0.15);
    color: var(--color-green);
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .section-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  /* Podcast Grid */
  .podcast-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .podcast-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ai-news-only-grid {
    grid-template-columns: minmax(0, 720px);
    justify-content: start;
  }

  .ai-news-only-grid .podcast-embed-wrapper {
    height: clamp(180px, 24vw, 280px);
    padding-bottom: 0;
  }


  .podcast-library-card {
    display: grid;
    gap: 1rem;
    min-height: 100%;
    padding: 1.25rem;
    background:
      radial-gradient(circle at top left, rgba(67, 214, 168, 0.18), transparent 34%),
      var(--color-surface);
    border: 1px solid rgba(67, 214, 168, 0.28);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .podcast-library-card:hover {
    border-color: var(--color-green);
    transform: translateY(-4px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(67, 214, 168, 0.22);
  }

  .library-kicker {
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .podcast-library-hero h3 {
    color: var(--color-text-primary);
    font-size: 1.35rem;
    margin: 0.4rem 0 0.5rem;
  }

  .podcast-library-hero p {
    color: var(--color-text-secondary);
    line-height: 1.65;
    font-size: 0.92rem;
  }

  .library-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .library-stats span {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgba(67, 214, 168, 0.12);
    color: var(--color-green);
    font-size: 0.78rem;
  }

  .featured-podcast-list {
    display: grid;
    gap: 0.65rem;
  }

  .featured-podcast-card {
    padding: 0.75rem;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: rgba(17, 8, 17, 0.72);
  }

  .featured-podcast-meta {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .featured-podcast-card strong {
    color: var(--color-text-primary);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  /* Podcast Embed Card - 빨간색 테마 (팟캐스트 아이콘과 통일) */
  .podcast-embed-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid rgba(255, 0, 0, 0.3);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .podcast-embed-card:hover {
    border-color: #ff0000;
    transform: translateY(-4px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(255, 0, 0, 0.4);
  }

  .podcast-embed-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    background: var(--color-bg-secondary);
  }

  .podcast-embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .podcast-embed-card:hover .podcast-embed-wrapper iframe {
    pointer-events: auto;
  }

  .podcast-embed-info {
    padding: 1rem 1.25rem;
  }

  .podcast-embed-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .podcast-embed-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* news 카드도 같은 빨간색 테마 유지 (팟캐스트 섹션 통일) */

  /* Essays Grid */
  .essays-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  /* Essay Card - 보라색 테마 (에세이 아이콘과 통일) */
  .essay-card {
    background: var(--color-surface);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .essay-card:hover {
    border-color: #a855f7;
    transform: translateY(-4px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(168, 85, 247, 0.4);
  }

  .essay-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .essay-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .essay-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .essay-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .essay-author {
    font-size: 0.8rem;
    font-weight: 600;
    color: #a855f7;
  }

  .essay-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .essay-external {
    margin-left: auto;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
  }

  /* Presentations */
  .presentations-scroll {
    overflow-x: scroll;
    margin: 0 -1rem;
    padding: 0 1rem;
    -webkit-overflow-scrolling: touch;
  }

  .presentations-scroll::-webkit-scrollbar {
    height: 10px;
  }

  .presentations-scroll::-webkit-scrollbar-track {
    background: var(--color-bg-secondary);
    border-radius: 5px;
  }

  .presentations-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-hover);
    border-radius: 5px;
    border: 2px solid var(--color-bg-secondary);
  }

  .presentations-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }

  .presentations-track {
    display: flex;
    gap: 1.25rem;
    padding: 0.5rem 0 1rem;
  }

  /* Presentation Card - 파란색 테마 (발표 아이콘과 통일) */
  .presentation-card {
    flex-shrink: 0;
    width: 260px;
    background: var(--color-surface);
    border: 1px solid rgba(95, 173, 254, 0.3);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .presentation-card:hover {
    border-color: var(--color-blue);
    transform: translateY(-4px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(95, 173, 254, 0.4);
  }

  .presentation-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(135deg, rgba(95, 173, 254, 0.1) 0%, rgba(95, 173, 254, 0.05) 100%);
    color: var(--color-blue);
    position: relative;
  }

  .presentation-type-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--color-blue);
    color: white;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .presentation-info {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .presentation-event {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-blue);
    text-transform: uppercase;
  }

  .presentation-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .presentation-speaker {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .presentation-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: auto;
  }

  .view-all-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.3s;
  }

  .view-all-link:hover {
    color: var(--color-text-primary);
  }

  /* Archive Section - 초록색 테마 (자료 창고) */
  .archive-icon {
    background: rgba(67, 214, 168, 0.15);
    color: var(--color-green);
  }

  /* Archive Grid - 3 columns on desktop */
  .archive-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .archive-card {
    background: var(--color-surface);
    border: 1px solid rgba(67, 214, 168, 0.3);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .archive-card:hover {
    border-color: var(--color-green);
    transform: translateY(-2px);
    box-shadow:
