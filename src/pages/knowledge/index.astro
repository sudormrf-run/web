---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'ko';
const { t } = useTranslations(locale);
---

<Layout title={t('knowledge.title')} locale={locale}>
  <div class="knowledge-page">
    <div class="container">
      <!-- Physical AI Section -->
      <section class="topic-section">
        <header class="section-header">
          <h2 class="section-title">Physical AI</h2>
          <a href="/knowledge/physical-ai" class="explore-link">
            자세히 보기
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </header>
        <div class="cards-grid">
          <a href="/knowledge/physical-ai/browse" class="card card-graph">
            <div class="card-thumbnail">
              <img src="/images/graph-thumbnail.png" alt="Knowledge Graph" loading="lazy" />
            </div>
            <div class="card-body">
              <h3 class="card-title">그래프 색인</h3>
              <p class="card-description">문서 간 연결 관계를 그래프로 탐색</p>
            </div>
          </a>
          <a href="/knowledge/physical-ai" class="card card-overview">
            <div class="card-visual">
              <div class="visual-bg"></div>
              <div class="visual-content">
                <div class="roadmap">
                  <div class="roadmap-line"></div>
                  <div class="roadmap-steps">
                    <div class="roadmap-step">
                      <span class="step-dot"></span>
                      <span class="step-label">VLA란?</span>
                    </div>
                    <div class="roadmap-step">
                      <span class="step-dot"></span>
                      <span class="step-label">Generalist</span>
                    </div>
                    <div class="roadmap-step">
                      <span class="step-dot"></span>
                      <span class="step-label">Scaling</span>
                    </div>
                    <div class="roadmap-step">
                      <span class="step-dot"></span>
                      <span class="step-label">Challenges</span>
                    </div>
                  </div>
                  <div class="roadmap-arrow">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </div>
                <div class="start-badge">
                  <span class="badge-text">START</span>
                </div>
              </div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Physical AI 입문 가이드</h3>
              <p class="card-description">Physical AI의 정의, 핵심 개념, 그리고 도전 과제를 안내하는 서론</p>
            </div>
          </a>
          <a href="/knowledge/essays/archive/physical-ai-is-coming" class="card card-video">
            <div class="card-visual card-visual-video">
              <div class="visual-bg-video"></div>
              <div class="play-button">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Physical AI is Coming</h3>
              <p class="card-description">발표 자료와 함께 보는 Physical AI 트렌드 분석</p>
            </div>
          </a>
        </div>
      </section>

      <!-- Articles Section -->
      <section class="topic-section">
        <header class="section-header">
          <h2 class="section-title">Articles</h2>
          <p class="section-subtitle">직접 읽고 정리한 글, 그리고 팟캐스트에서 화면에 띄우고 진행하는 대본</p>
        </header>
        <div class="cards-grid">
          <a href="/knowledge/articles/ai-native-startup-playbook" class="card card-article">
            <div class="card-thumbnail">
              <img
                src="https://img.youtube.com/vi/Z3JyAqh4ixg/hqdefault.jpg"
                alt="AI 네이티브 스타트업 플레이북"
                loading="lazy"
              />
              <span class="article-badge">진행 대본</span>
            </div>
            <div class="card-body">
              <h3 class="card-title">AI 네이티브 스타트업 플레이북</h3>
              <p class="card-description">
                마크다운 파일이 곧 직원이다 — Tom Blomfield의 AI 네이티브 컴퍼니 발표와
                Garry Tan 인터뷰를 하나의 플레이북으로 엮은 대본
              </p>
              <div class="card-tags">
                <span>2 Sessions</span>
                <span>Quotes</span>
                <span>Slides</span>
              </div>
            </div>
          </a>
          <a href="/knowledge/articles/yc-startup-school-2026" class="card card-article">
            <div class="card-thumbnail">
              <img
                src="https://img.youtube.com/vi/eRrc1pUY5oU/hqdefault.jpg"
                alt="YC Startup School 2026"
                loading="lazy"
              />
              <span class="article-badge">진행 대본</span>
            </div>
            <div class="card-body">
              <h3 class="card-title">YC Startup School 2026</h3>
              <p class="card-description">
                젠슨 황부터 클로드 코드를 만든 사람까지, 9개 세션 전체 트랜스크립트를 읽고 뽑은
                인용구와 토론 포인트
              </p>
              <div class="card-tags">
                <span>9 Sessions</span>
                <span>Quotes</span>
                <span>YouTube</span>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- LLM Section -->
      <section class="topic-section">
        <header class="section-header">
          <h2 class="section-title">LLM</h2>
        </header>
        <div class="cards-grid">
          <a href="https://sudormrf.run/2025/02/27/pretraining/" target="_blank" rel="noopener noreferrer" class="card card-link">
            <h3 class="card-title">
              LLM을 만드는 법
              <svg class="external-icon" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </h3>
            <p class="card-description">LLM 사전학습의 전체 과정을 다루는 가이드</p>
          </a>
          <a href="https://jonhpark7966.github.io/FineTuning_Course/" target="_blank" rel="noopener noreferrer" class="card card-link">
            <h3 class="card-title">
              LLM 파인 튜닝 워크샵 리소스
              <svg class="external-icon" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </h3>
            <p class="card-description">LLM 파인 튜닝 실습을 위한 워크샵 자료 모음</p>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .knowledge-page {
    padding: 3rem 0 5rem;
  }

  /* Topic Section */
  .topic-section {
    margin-bottom: 3rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .explore-link:hover {
    gap: 0.5rem;
  }

  /* Cards Grid - Fixed width cards */
  .cards-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
    width: 280px;
    min-height: 100px;
  }

  .card-placeholder {
    border-style: dashed;
    opacity: 0.5;
  }

  .card-graph {
    width: 320px;
    min-height: auto;
    padding: 0;
    overflow: hidden;
  }

  .card-thumbnail {
    width: 100%;
    height: 160px;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card-graph:hover .card-thumbnail img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-graph .card-title {
    margin-bottom: 0.25rem;
  }

  .card-graph .card-description {
    margin: 0;
  }

  .card-overview {
    width: 320px;
    min-height: auto;
    padding: 0;
    overflow: hidden;
  }

  /* Article card */
  .card-article {
    width: 380px;
    min-height: auto;
    padding: 0;
    overflow: hidden;
  }

  .card-article .card-thumbnail {
    position: relative;
    height: 180px;
  }

  .article-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .card-article:hover {
    border-color: var(--color-accent);
  }

  .card-article:hover .card-thumbnail img {
    transform: scale(1.05);
  }

  .card-article:hover .card-title {
    color: var(--color-accent);
  }

  .card-article .card-title {
    margin-bottom: 0.375rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .card-tags span {
    padding: 0.15rem 0.45rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.65rem;
  }

  .card-visual {
    width: 100%;
    height: 160px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .visual-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.06) 0%, rgba(139, 92, 246, 0.1) 100%);
  }

  .visual-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem 1.5rem;
  }

  .start-badge {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-accent);
    border-radius: 4px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .badge-text {
    font-size: 0.6rem;
    font-weight: 700;
    color: white;
    letter-spacing: 0.05em;
  }

  .roadmap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .roadmap-line {
    position: absolute;
    left: 1.5rem;
    right: 3rem;
    top: 50%;
    height: 2px;
    background: linear-gradient(90deg,
      var(--color-accent) 0%,
      rgba(139, 92, 246, 0.5) 100%
    );
    margin-top: 0.25rem;
    opacity: 0.3;
  }

  .roadmap-steps {
    display: flex;
    justify-content: space-between;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .roadmap-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s;
  }

  .card-overview:hover .roadmap-step:nth-child(1) { transform: translateY(-2px); transition-delay: 0ms; }
  .card-overview:hover .roadmap-step:nth-child(2) { transform: translateY(-2px); transition-delay: 50ms; }
  .card-overview:hover .roadmap-step:nth-child(3) { transform: translateY(-2px); transition-delay: 100ms; }
  .card-overview:hover .roadmap-step:nth-child(4) { transform: translateY(-2px); transition-delay: 150ms; }

  .step-dot {
    width: 12px;
    height: 12px;
    background: var(--color-bg-primary);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    transition: all 0.2s;
  }

  .card-overview:hover .step-dot {
    background: var(--color-accent);
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.5);
  }

  .step-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .card-overview:hover .step-label {
    color: var(--color-text-secondary);
  }

  .roadmap-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(59, 130, 246, 0.15);
    border-radius: 50%;
    flex-shrink: 0;
    transition: all 0.3s;
  }

  .roadmap-arrow svg {
    color: var(--color-accent);
    transition: transform 0.3s;
  }

  .card-overview:hover .roadmap-arrow {
    background: var(--color-accent);
  }

  .card-overview:hover .roadmap-arrow svg {
    color: white;
    transform: translateX(2px);
  }

  .card-overview .card-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-overview .card-title {
    margin-bottom: 0.25rem;
  }

  .card-overview .card-description {
    margin: 0;
  }

  .card-overview:hover {
    border-color: var(--color-accent);
  }

  .card-overview:hover .card-title {
    color: var(--color-accent);
  }

  .card-video {
    width: 320px;
    min-height: auto;
    padding: 0;
    overflow: hidden;
  }

  .card-visual-video {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  }

  .visual-bg-video {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(255, 0, 0, 0.1) 0%, transparent 70%);
  }

  .play-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: rgba(255, 0, 0, 0.9);
    border-radius: 50%;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(255, 0, 0, 0.3);
  }

  .play-button svg {
    color: white;
    margin-left: 4px;
  }

  .card-video:hover .play-button {
    transform: scale(1.1);
    background: rgba(255, 0, 0, 1);
    box-shadow: 0 6px 30px rgba(255, 0, 0, 0.5);
  }

  .card-video:hover {
    border-color: rgba(255, 0, 0, 0.5);
  }

  .card-video:hover .card-title {
    color: #ff4444;
  }

  .card-video .card-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-video .card-title {
    margin-bottom: 0.25rem;
  }

  .card-video .card-description {
    margin: 0;
  }

  .card-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  .card-link:hover .card-title {
    color: var(--color-accent);
  }

  .external-icon {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .card-link:hover .external-icon {
    opacity: 1;
  }

  .card-description {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    flex: 1;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .knowledge-page {
      padding: 2rem 0 3rem;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }

    .card {
      width: 100%;
    }
  }
</style>
