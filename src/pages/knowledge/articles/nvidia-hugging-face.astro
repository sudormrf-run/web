---
import Layout from '../../../layouts/Layout.astro';
import data from '../../../data/nvidia-hugging-face.json';

const locale = 'ko';
const { event, runOfShow, money, sessions, embeds, themes, tensions, closing } = data;

const tabs = [
  { id: 'run', label: '진행 대본', kicker: 'START' },
  { id: 'money', label: '돈의 지도', kicker: '$$' },
  ...sessions.map((s) => ({ id: s.id, label: s.speaker, kicker: `0${s.order}` })),
  { id: 'wrap', label: '관통 주제', kicker: 'END' },
];

// Chart geometry. These are plain numbers rather than a charting lib so the SVG
// ships in the HTML — no client JS needed to see the numbers, which matters when
// the page is being screen-shared live.

// Line chart for the Hugging Face ARR curve: map points into a 0-100 viewBox.
const arrChart = money.charts.find((c: any) => c.id === 'arr')!;
const linePts = (arrChart.points as any[]).map((pt, i, all) => ({
  ...pt,
  x: (i / (all.length - 1)) * 100,
  y: 100 - (pt.value / arrChart.max) * 100,
}));
const solidPath = linePts.filter((p) => !p.projected);
const toPath = (pts: typeof linePts) => pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');
const areaPath = `${toPath(solidPath)} L${solidPath[solidPath.length - 1].x.toFixed(2)},100 L0,100 Z`;
const dashPath = toPath(linePts.slice(solidPath.length - 1));

// Self-hosted maxres stills rather than img.youtube.com/hqdefault: sharper on the
// facade, and nothing is requested from YouTube until the play button is pressed.
const thumb = (id: string) => `/assets/articles/nvidia-hugging-face/${id}.jpg`;

// Only some sessions carry background blocks, so pull them into a lookup
// rather than widening every session's type.
type ContextBlock = {
  badge: string;
  title: string;
  body: string[];
  note?: string;
  links?: { label: string; url: string; note?: string }[];
};
const contextById = Object.fromEntries(
  (sessions as any[]).filter((s) => s.context).map((s) => [s.id, s.context as ContextBlock[]])
);
---

<Layout
  title="18조 원짜리 포옹 — 엔비디아는 왜 허깅페이스를 사는가 · 팟캐스트 진행 대본"
  description="엔비디아의 허깅페이스 $12.9B (약 18조 원) 인수 보도 — 사실과 소문의 구분, 케빈 듀란트의 캡테이블, 깃허브·스케일·Arm 판례 비교, 그리고 우리가 석 달 전 파리 본사에서 직접 들은 대답들. 진행 대본."
  locale={locale}
  hideLanguageSwitcher={true}
>
  <div class="article">
    <div class="container">
      <!-- Source strip -->
      <a class="source-strip" href={event.sourceUrl} target="_blank" rel="noopener noreferrer">
        <span class="source-badge">출처</span>
        <span class="source-text">{event.sourceLabel}</span>
        <span class="source-url">theinformation.com</span>
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- Tabs -->
      <nav class="tabs" id="tabs" aria-label="세션 탭">
        {tabs.map((t, i) => (
          <button class:list={['tab', { 'is-active': i === 0 }]} data-tab={t.id} type="button">
            <span class="tab-kicker">{t.kicker}</span>
            <span class="tab-label">{t.label}</span>
          </button>
        ))}
      </nav>

      <!-- ==================== PANEL: RUN OF SHOW ==================== -->
      <section class="panel is-active" data-panel="run">
        <header class="hero">
          <div class="hero-media">
            <img src={event.heroImage} alt={`${event.name} — ${event.heroImageCredit}`} loading="eager" />
            <span class="hero-credit">{event.heroImageCredit}</span>
          </div>
          <div class="hero-copy">
            <div class="hero-kicker">{event.host} · {event.venue}</div>
            <h1>{event.name}</h1>
            <div class="hero-stats">
              <div><strong>{event.talkCount}</strong><span>Sessions</span></div>
              <div><strong>{runOfShow.totalMinutes}</strong><span>분 예상</span></div>
              <div><strong>{sessions.reduce((n, s) => n + s.quotes.length, 0)}</strong><span>Quotes</span></div>
              <div><strong>{sessions.reduce((n, s) => n + s.discussion.length, 0)}</strong><span>논점</span></div>
            </div>
          </div>
        </header>

        {event.intro.map((p) => <p class="lead">{p}</p>)}

        <aside class="hook">
          <div class="hook-badge">{event.hook.badge}</div>
          <h2>{event.hook.title}</h2>
          <p>{event.hook.body}</p>
          <button class="hook-jump" data-jump="money" type="button">돈의 지도부터 보기 →</button>
        </aside>

        <!-- Opening script -->
        <div class="block">
          <h2 class="block-title"><span class="num">00</span>오프닝 멘트</h2>
          <ul class="script-list">
            {runOfShow.openingScript.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <!-- Flow -->
        <div class="block">
          <h2 class="block-title"><span class="num">01</span>오늘의 흐름</h2>
          <p class="block-note">
            질문 세 개를 순서대로 답합니다. 이 주소는 왜 18조가 됐는가(돈·1막) →
            주인이 생기면 어떤 결말이 가능한가(2막) → 값이 붙기 전에 그 안에서 우리는 무엇을 봤는가(3막).
            오프닝은 “팔린 뉴스”가 아니라 “값이 생긴 뉴스”로 고정하고, 돈의 지도에서 비교 기준은 2023년 시리즈D $4.5B다. $7B 매각 거절은 없다.
          </p>
          <ol class="flow">
            {runOfShow.segments.map((seg) => (
              <li>
                <span class="flow-slot">{seg.slot}</span>
                <span class="flow-label">{seg.label}</span>
                <span class="flow-min">{seg.min}분</span>
              </li>
            ))}
          </ol>
        </div>

        <!-- Quote wall -->
        <div class="block">
          <h2 class="block-title"><span class="num">02</span>딱 하나씩만 고른 인용구</h2>
          <p class="block-note">세션당 한 문장씩. 화면에 띄워 놓고 읽으면서 넘어가기 좋게 골랐습니다.</p>
          <div class="quote-wall">
            {sessions.map((s) => (
              <blockquote class:list={['quote-card', `accent-${s.accent}`]}>
                <p class="q-ko">{s.bestQuoteKo}</p>
                <p class="q-en">“{s.bestQuoteEn}”</p>
                <footer>
                  <button class="q-jump" data-jump={s.id} type="button">
                    <span class="q-order">{s.order}</span>
                    {s.speaker}
                    <span class="q-role">{s.role.split('(')[0].trim()}</span>
                  </button>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>

        <!-- Discussion highlights -->
        <div class="block">
          <h2 class="block-title"><span class="num">03</span>제일 붙기 좋은 논점</h2>
          <p class="block-note">각 세션에서 하나씩 뽑았습니다. 전체 논점은 각 세션 탭에 들어 있습니다.</p>
          <div class="dp-grid">
            {sessions.map((s) => (
              <div class="dp-card">
                <div class="dp-head">
                  <span class:list={['dp-num', `accent-${s.accent}`]}>{s.order}</span>
                  <span class="dp-speaker">{s.speaker}</span>
                </div>
                <p>{s.discussion[0]}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Tension teaser -->
        <div class="block">
          <h2 class="block-title"><span class="num">04</span>서로 반대되는 말들</h2>
          <p class="block-note">방송 마지막에 몰아서 다루면 좋은 대목입니다. 전문은 “관통 주제” 탭에 있습니다.</p>
          <div class="tension-teaser">
            {tensions.map((t) => (
              <div class="tt-item">
                <span class="tt-a">{t.a.who}</span>
                <span class="tt-vs">vs</span>
                <span class="tt-b">{t.b.who}</span>
                <span class="tt-topic">{t.topic}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ==================== PANEL: MONEY ==================== -->
      <section class="panel" data-panel="money">
        <header class="wrap-head">
          <h1>{money.title}</h1>
          <p>{money.lead}</p>
          {money.fx && <p class="fx-note">{money.fx.note}</p>}
        </header>

        <!-- Stat tiles: the four numbers to read out loud -->
        <div class="tiles">
          {money.tiles.map((t) => (
            <div class:list={['tile', `accent-${t.accent}`]}>
              <div class="tile-value">{t.value}</div>
              {t.krw && <div class="tile-krw">{t.krw}</div>}
              <div class="tile-label">{t.label}</div>
              <div class="tile-note">{t.note}</div>
            </div>
          ))}
        </div>

        <!-- Chart 1: the valuation ladder — closed rounds vs unsigned reported price -->
        {money.charts.filter((c) => c.id === 'ladder').map((c) => (
          <figure class="chart">
            <figcaption class="chart-head">
              <h2>{c.title}</h2>
              <p>{c.subtitle}</p>
            </figcaption>
            <div class="chart-legend">
              {c.legend.map((l) => (
                <span class="legend-item"><i class:list={['swatch', `g-${l.group}`]} />{l.label}</span>
              ))}
            </div>
            <div class="bars">
              {c.series.map((d) => (
                <div class="bar-row">
                  <div class="bar-label">{d.label}<span>{d.note}</span></div>
                  <div class="bar-track">
                    <div class:list={['bar-fill', `g-${d.group}`]} style={`width:${(d.value / c.max) * 100}%`} />
                    <span class="bar-value">
                      {d.display}
                      {d.krw && <span class="bar-krw">{d.krw}</span>}
                    </span>
                  </div>
                </div>
              ))}
            </div>
            <p class="chart-caption">{c.caption}</p>
          </figure>
        ))}

        <!-- Chart 2: Hugging Face ARR line -->
        <figure class="chart">
          <figcaption class="chart-head">
            <h2>{arrChart.title}</h2>
            <p>{arrChart.subtitle}</p>
          </figcaption>
          <div class="linechart">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path class="area" d={areaPath} />
              <path class="line" d={toPath(solidPath)} vector-effect="non-scaling-stroke" />
              <path class="line dashed" d={dashPath} vector-effect="non-scaling-stroke" />
            </svg>
            <div class="line-dots">
              {linePts.map((pt, i) => (
                <div
                  class:list={[
                    'line-dot',
                    { 'is-projected': pt.projected, 'is-first': i === 0, 'is-last': i === linePts.length - 1 },
                  ]}
                  style={`left:${pt.x}%;bottom:${(pt.value / arrChart.max) * 100}%`}
                >
                  <span class="dot-value">
                    {pt.display}
                    {pt.krw && <span class="dot-krw">{pt.krw}</span>}
                  </span>
                  <i />
                  <span class="dot-label">{pt.label}</span>
                </div>
              ))}
            </div>
          </div>
          <p class="chart-caption">{arrChart.caption}</p>
        </figure>

        <!-- Chart 3: comparable deals, colored by outcome -->
        {money.charts.filter((c) => c.id === 'comps').map((c) => (
          <figure class="chart">
            <figcaption class="chart-head">
              <h2>{c.title}</h2>
              <p>{c.subtitle}</p>
            </figcaption>
            <div class="chart-legend">
              {c.legend.map((l) => (
                <span class="legend-item"><i class:list={['swatch', `g-${l.group}`]} />{l.label}</span>
              ))}
            </div>
            <div class="bars">
              {c.series.map((d) => (
                <div class="bar-row">
                  <div class="bar-label">{d.label}<span>{d.note}</span></div>
                  <div class="bar-track">
                    <div class:list={['bar-fill', `g-${d.group}`]} style={`width:${(d.value / c.max) * 100}%`} />
                    <span class="bar-value">
                      {d.display}
                      {d.krw && <span class="bar-krw">{d.krw}</span>}
                    </span>
                  </div>
                </div>
              ))}
            </div>
            <p class="chart-caption">{c.caption}</p>
          </figure>
        ))}

        <!-- Supporting notes -->
        <div class="block">
          <h2 class="block-title"><span class="num">배경</span>같이 봐야 할 숫자들</h2>
          <div class="money-notes">
            {money.notes.map((n) => (
              <article class="mnote">
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </article>
            ))}
          </div>
        </div>

        <!-- X embeds live here: they are the primary-source receipts for the numbers above -->
        <div class="block">
          <h2 class="block-title"><span class="num">원문</span>당사자들이 직접 올린 글</h2>
          <p class="block-note">
            X 포스트를 그대로 임베드했습니다. 방송 중에 화면에 띄우기 좋습니다.
            (위젯이 로드되지 않으면 아래 인용문이 그대로 보입니다.)
          </p>
          <div class="xwall">
            {embeds.map((e) => (
              <div class="xcard">
                <div class="xcard-why">
                  <span class="xcard-handle">{e.handle}</span>
                  <span class="xcard-who">{e.who}</span>
                  <span class="xcard-when">{e.when}</span>
                </div>
                <p class="xcard-note">{e.why}</p>
                <blockquote class="twitter-tweet" data-theme="dark" data-dnt="true" data-conversation="none">
                  <p lang="en" dir="ltr">{e.fallback}</p>
                  <a href={e.url}>원문 보기 ↗</a>
                </blockquote>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ==================== PANELS: SESSIONS ==================== -->
      {sessions.map((s) => (
        <section class="panel" data-panel={s.id}>
          <header class:list={['s-head', `accent-${s.accent}`]}>
            <div class="s-order">{String(s.order).padStart(2, '0')}</div>
            <div class="s-head-copy">
              <h1>{s.titleKo}</h1>
              <p class="s-original">{s.title}</p>
              <p class="s-meta">
                <strong>{s.speaker}</strong> · {s.role}
                {s.durationMin && <span class="s-dur">{s.durationMin}분</span>}
                <span class="s-slot">방송 배분 {s.slotMin}분</span>
              </p>
            </div>
          </header>

          <p class="s-oneliner">{s.oneLiner}</p>
          <p class="s-why"><span>이 자리에 배치한 이유</span>{s.whyFirst}</p>

          {contextById[s.id]?.map((c) => (
            <aside class:list={['ctx', `accent-${s.accent}`]}>
              <div class="ctx-badge">{c.badge}</div>
              <h2 class="ctx-title">{c.title}</h2>
              {c.body.map((p) => <p class="ctx-p">{p}</p>)}
              {c.note && <p class="ctx-note">{c.note}</p>}
              {!!c.links?.length && <div class="ctx-links">
                {c.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer">
                    <span class="ctx-link-label">{l.label}</span>
                    {l.note && <span class="ctx-link-note">{l.note}</span>}
                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ))}
              </div>}
            </aside>
          ))}

          {s.youtubeId && (
            <div class="video" data-video={s.youtubeId} data-title={s.title}>
              <img src={thumb(s.youtubeId)} alt={`${s.title} 썸네일`} loading="lazy" />
              <button class="video-play" type="button" aria-label="유튜브 영상 재생">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </button>
            </div>
          )}
          <div class="video-links">
            {s.links.map((l) => (
              <a href={l.url} target={l.url.startsWith('/') ? undefined : '_blank'} rel={l.url.startsWith('/') ? undefined : 'noopener noreferrer'}>{l.label}</a>
            ))}
          </div>

          {s.slides.length > 0 && (
            <div class="block">
              <h2 class="block-title"><span class="num">화면</span>띄워 놓을 캡처</h2>
              <div class="slides">
                {s.slides.map((sl) => (
                  <figure class="slide">
                    <img src={sl.src} alt={sl.caption} loading="lazy" />
                    <figcaption>{sl.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}

          <div class="block">
            <h2 class="block-title"><span class="num">요약</span>무슨 얘기를 했나</h2>
            <ul class="bullets">
              {s.summary.map((b) => <li>{b}</li>)}
            </ul>
          </div>

          <div class="block">
            <h2 class="block-title"><span class="num">인용</span>읽고 갈 문장들</h2>
            <div class="quotes">
              {s.quotes.map((q) => (
                <blockquote class:list={['quote', `accent-${s.accent}`]}>
                  <p class="q-ko">{q.ko}</p>
                  <p class="q-en">“{q.en}”</p>
                  <p class="q-why">{q.why}</p>
                </blockquote>
              ))}
            </div>
          </div>

          <div class="block">
            <h2 class="block-title"><span class="num">재미</span>웃기거나 의외인 부분</h2>
            <ul class="bullets fun">
              {s.funParts.map((b) => <li>{b}</li>)}
            </ul>
          </div>

          <div class="block">
            <h2 class="block-title"><span class="num">토론</span>주고받을 논점</h2>
            <ol class="dp-list">
              {s.discussion.map((b) => <li>{b}</li>)}
            </ol>
          </div>

          <div class="block">
            <h2 class="block-title"><span class="num">실전</span>가져갈 것</h2>
            <ul class="bullets take">
              {s.takeaways.map((b) => <li>{b}</li>)}
            </ul>
          </div>

          <div class="korea">
            <h3>한국에서 보면</h3>
            <p>{s.koreaAngle}</p>
          </div>
        </section>
      ))}

      <!-- ==================== PANEL: WRAP ==================== -->
      <section class="panel" data-panel="wrap">
        <header class="wrap-head">
          <h1>관통 주제와 대립 구도</h1>
          <p>세 개의 막이 같은 질문 하나로 수렴한다 — 중립은 팔 수 있는 상품인가. 갈리는 건 그 다음부터다.</p>
        </header>

        <div class="block">
          <h2 class="block-title"><span class="num">공통</span>반복해서 나온 이야기</h2>
          <div class="themes">
            {themes.map((t, i) => (
              <article class="theme">
                <div class="theme-num">{String(i + 1).padStart(2, '0')}</div>
                <div class="theme-body">
                  <h3>{t.title}</h3>
                  <p>{t.body}</p>
                  <div class="theme-who">
                    {t.who.map((w) => <span>{w}</span>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="block">
          <h2 class="block-title"><span class="num">대립</span>정면으로 부딪히는 지점</h2>
          <div class="tensions">
            {tensions.map((t) => (
              <article class="tension">
                <h3>{t.topic}</h3>
                <div class="tension-pair">
                  <div class="side side-a">
                    <span class="side-who">{t.a.who}</span>
                    <p>{t.a.claim}</p>
                  </div>
                  <div class="side-vs">vs</div>
                  <div class="side side-b">
                    <span class="side-who">{t.b.who}</span>
                    <p>{t.b.claim}</p>
                  </div>
                </div>
                <p class="tension-ask">{t.ask}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="block">
          <h2 class="block-title"><span class="num">마무리</span>{closing.title}</h2>
          <ol class="closing">
            {closing.points.map((p) => <li>{p}</li>)}
          </ol>
        </div>

        <a class="source-strip bottom" href={event.sourceUrl} target="_blank" rel="noopener noreferrer">
          <span class="source-badge">출처</span>
          <span class="source-text">{event.sourceLabel}</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </section>
    </div>
  </div>
  <script async src="https://platform.twitter.com/widgets.js" charset="utf-8" is:inline></script>
</Layout>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function activate(id: string, pushHash = true) {
    const exists = panels.some((p) => p.dataset.panel === id);
    if (!exists) return;
    tabButtons.forEach((b) => b.classList.toggle('is-active', b.dataset.tab === id));
    panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === id));
    if (pushHash) history.replaceState(null, '', `#${id}`);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    const active = tabButtons.find((b) => b.dataset.tab === id);
    active?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  }

  // X embeds inside a display:none panel measure to zero width, so ask the widget
  // factory to re-render whenever a panel becomes visible.
  function reloadTweets() {
    (window as any).twttr?.widgets?.load?.(document.querySelector('.xwall'));
  }

  tabButtons.forEach((b) => b.addEventListener('click', () => { activate(b.dataset.tab!); reloadTweets(); }));
  document.querySelectorAll<HTMLButtonElement>('.q-jump').forEach((b) => {
    b.addEventListener('click', () => activate(b.dataset.jump!));
  });

  // Deep link support: /knowledge/articles/yc-startup-school-2026#jeff-dean
  if (location.hash) activate(location.hash.slice(1), false);
  window.addEventListener('load', reloadTweets);
  window.addEventListener('hashchange', () => activate(location.hash.slice(1), false));

  // Arrow keys move between tabs — handy while presenting on stream.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const i = tabButtons.findIndex((b) => b.classList.contains('is-active'));
    const next = e.key === 'ArrowRight' ? i + 1 : i - 1;
    if (next < 0 || next >= tabButtons.length) return;
    e.preventDefault();
    activate(tabButtons[next].dataset.tab!);
  });

  // YouTube facade: only load the iframe once asked, so nine embeds don't
  // all phone home when the page opens.
  document.querySelectorAll<HTMLElement>('.video').forEach((box) => {
    box.querySelector('.video-play')?.addEventListener('click', () => {
      const id = box.dataset.video;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = box.dataset.title || 'YouTube';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
      box.classList.add('is-playing');
    });
  });
</script>

