---
import Layout from '../../../layouts/Layout.astro';
import SourceQuote from '../../../components/podcast/SourceQuote.astro';
import report from '../../../data/ai-2027.json';

// The deck follows the existing podcast article pattern; its content lives in JSON.
type Source = (typeof report.sources)[number];
interface Scene {
  id: string; group: string; nav: string; kicker: string; title: string;
  lead?: string; quoteId?: keyof typeof report.quotes; chain?: string[];
  prediction?: { period: string; body: string; sourceId: string };
  facts?: { value: string; label: string; note: string; sourceId: string; tone: string }[];
  events?: { date: string; title: string; body: string; sourceId: string; type: string }[];
  verdict?: { label: string; tone: string; body: string };
  details?: { title: string; body: string[]; sourceIds: string[] }[];
  reviews?: { date: string; value: string; title: string; body: string; caveat: string; sourceId: string }[];
  timelineId?: keyof typeof report.future;
  showVideos?: boolean; showBranches?: boolean; showDiscussion?: boolean; showSources?: boolean;
  question?: string; hostNote?: string;
}
const scenes = report.sections as Scene[];
const groups = [...new Set(scenes.map(scene => scene.group))];
const sourceById = Object.fromEntries(report.sources.map(source => [source.id, source])) as Record<string, Source>;
const source = (id: string) => {
  if (!sourceById[id]) throw new Error(`Missing AI 2027 source: ${id}`);
  return sourceById[id];
};
const heroQuote = report.quotes.hero;
---

<Layout title={report.meta.title} description={report.meta.description} locale="ko" hideLanguageSwitcher>
  <article class="a27" data-ai-2027>
    <div class="dossier-shell">
      <nav class="breadcrumb" aria-label="현재 위치"><a href="/knowledge/">Knowledge</a><span aria-hidden="true">/</span><span>팟캐스트 자료</span></nav>

      <header class="dossier-hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-light" aria-hidden="true"></span>{report.meta.eyebrow}</p>
          <p class="report-wordmark" aria-hidden="true">AI <span>2027</span><span class="wordmark-dot">.</span></p>
          <h1 aria-label={report.meta.title}>{report.meta.heroTitle}</h1>
          <p class="hero-intro">{report.meta.intro}</p>
          <div class="hero-actions">
            <a class="button primary" href="#overview">함께 살펴보기 <span aria-hidden="true">↓</span></a>
            <a class="button" href={report.reportLinks[0].url} target="_blank" rel="noopener noreferrer">보고서 원문 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="hero-desk" aria-label="이번 검토의 범위">
          <div class="desk-top"><span>FORECAST / REALITY</span><span>REVIEW 01</span></div>
          <figure class="opening-quote">
            <span class="small-label">원문 인용 · 한국어 번역</span>
            <blockquote cite={source('original').url}>“{heroQuote.ko}”</blockquote>
            <p lang="en">{heroQuote.en}</p>
            <figcaption><a href={source('original').url} target="_blank" rel="noopener noreferrer">AI 2027 · 2025.04.03 <span aria-hidden="true">↗</span></a></figcaption>
          </figure>
          <div class="hero-findings">
            {report.meta.heroFindings.map((finding, i) => (
              <div class="hero-finding" data-tone={finding.tone}><span class="finding-num">0{i + 1}</span><div><span class="small-label">{finding.label}</span><p>{finding.body}</p></div></div>
            ))}
          </div>
          <p class="desk-note">{report.meta.scope}</p>
        </aside>
      </header>

      <dl class="edition-strip">
        <div><dt>보고서 발행</dt><dd>{report.meta.published}</dd></div>
        <div><dt>사후 검토 기준</dt><dd>{report.meta.reviewed}</dd></div>
        <div><dt>함께 볼 자료</dt><dd>{report.sources.length}<span>개 출처</span> / {report.videos.length}<span>개 영상</span></dd></div>
        <div><dt>방송 진행</dt><dd class="edition-small">{scenes.length}개 장면 <span>· {report.meta.duration}</span></dd></div>
      </dl>

      <div class="deck" id="reading-desk">
        <aside class="scene-rail" aria-label="장면 탐색">
          <div class="rail-heading"><span>ON THE TABLE</span><span>{String(scenes.length).padStart(2, '0')} SCENES</span></div>
          <nav class="scene-nav" aria-label="방송 장면">
            {groups.map((group, groupIndex) => (
              <div class="nav-group">
                <p class="group-label"><span>0{groupIndex + 1}</span>{group}</p>
                {scenes.filter(scene => scene.group === group).map(scene => (
                  <a href={`#${scene.id}`} id={`tab-${scene.id}`} data-scene-link={scene.id} aria-controls={scene.id}>
                    <span class="scene-number">{String(scenes.indexOf(scene) + 1).padStart(2, '0')}</span><span>{scene.nav}</span><span class="rail-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ))}
          </nav>
          <p class="rail-tip" data-controls><kbd>←</kbd><kbd>→</kbd> 장면 이동</p>
          <a class="rail-source" href="#sources">출처와 평가 기준 <span aria-hidden="true">↗</span></a>
        </aside>

        <div class="scene-stage">
          <div class="deck-toolbar" data-controls>
            <div class="scene-counter"><span data-current>01</span><span class="counter-divider">/ {String(scenes.length).padStart(2, '0')}</span><span class="current-nav" data-current-label>{scenes[0].nav}</span></div>
            <div class="view-actions"><button type="button" class="text-button" data-read-all aria-pressed="false">전체 읽기</button><button type="button" class="text-button" data-print>인쇄</button></div>
          </div>

          <div class="scenes">
            {scenes.map(scene => {
              const quote = scene.quoteId ? report.quotes[scene.quoteId] : undefined;
              const timeline = scene.timelineId ? report.future[scene.timelineId] : undefined;
              return (
                <section class="scene" id={scene.id} data-scene aria-labelledby={`heading-${scene.id}`} tabindex="0">
                  <header class="scene-heading"><p class="eyebrow">{scene.kicker}</p><h2 id={`heading-${scene.id}`}>{scene.title}</h2>{scene.lead && <p class="scene-lead">{scene.lead}</p>}</header>

                  {scene.showVideos && (
                    <>
                      <div class="report-links">{report.reportLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}</div>
                      <p class="report-authors"><span class="small-label">공동 저자</span>{report.meta.authors.join(' · ')}</p>
                      <details class="report-embed">
                        <summary>{report.reportEmbed.title}<span aria-hidden="true">＋</span></summary>
                        <p>{report.reportEmbed.note} <a href={report.reportLinks[1].url} target="_blank" rel="noopener noreferrer">{report.reportEmbed.linkLabel} ↗</a></p>
                        <iframe src={report.reportEmbed.url} title="AI 2027 원본 영문 보고서 PDF" width="1000" height="680" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                      </details>
                      <div class="video-grid">
                        {report.videos.map((video, i) => (
                          <article class="video-card">
                            <p class="video-kind"><span>0{i + 1}</span>{video.kind}</p>
                            <div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`} title={`${video.channel} — ${video.title}`} width="560" height="315" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
                            <div class="video-copy">
                              <p class="video-meta">{video.channel} <span>· {video.date} · {video.duration}</span></p>
                              <h3>{video.titleKo}</h3><p class="video-title" lang="en">{video.title}</p><p>{video.summary}</p>
                              {video.chapters && <div class="video-chapters">{video.chapters.map(chapter => <a href={`https://www.youtube.com/watch?v=${video.id}&t=${chapter.seconds}s`} target="_blank" rel="noopener noreferrer"><time>{chapter.time}</time>{chapter.label} <span aria-hidden="true">↗</span></a>)}</div>}
                              <p class="fine-print">{video.note}</p>
                              <div class="video-links"><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">YouTube에서 보기 ↗</a><a href={source(video.sourceId).url} target="_blank" rel="noopener noreferrer">제작자 소개 ↗</a></div>
                            </div>
                          </article>
                        ))}
                      </div>
                    </>
                  )}

                  {scene.chain && (
                    <div class="claim-chain" aria-label="보고서의 인과 가설">
                      {scene.chain.map((item, index) => <div class="chain-step"><span class="chain-index">0{index + 1}</span><strong>{item}</strong>{index < scene.chain!.length - 1 && <span class="chain-arrow" aria-hidden="true">→</span>}</div>)}
                    </div>
                  )}

                  {scene.id === 'overview' && <div class="reading-key"><div><span class="evidence-tag">관측</span><p>출시·측정·공개된 연구</p></div><div><span class="evidence-tag">자기평가</span><p>예측한 사람들이 내린 리뷰</p></div><div><span class="evidence-tag future-tag">미래</span><p>아직 확인하지 못한 시나리오</p></div><p class="method-note">{report.meta.method}</p></div>}

                  {scene.facts && <div class="fact-grid">{scene.facts.map(fact => <div class="fact" data-tone={fact.tone}><span class="small-label">{fact.label}</span><strong>{fact.value}</strong><p>{fact.note} <a class="source-cite" href={source(fact.sourceId).url} target="_blank" rel="noopener noreferrer" aria-label={`출처 ${source(fact.sourceId).label}: ${source(fact.sourceId).title}`}>[{source(fact.sourceId).label}] ↗</a></p></div>)}</div>}

                  {quote && <SourceQuote quote={quote} source={source(quote.sourceId)} />}

                  {scene.prediction && <div class="prediction"><div><span class="comparison-label">그때의 예측</span><span class="prediction-period">{scene.prediction.period}</span></div><p>{scene.prediction.body} <a class="source-cite" href={source(scene.prediction.sourceId).url} target="_blank" rel="noopener noreferrer" aria-label={`예측 원문 ${source(scene.prediction.sourceId).title}`}>[{source(scene.prediction.sourceId).label}] ↗</a></p></div>}

                  {scene.events && (
                    <div class="events"><p class="comparison-label">이후 확인한 일</p>{scene.events.map(event => <article class="event"><div class="event-date"><time>{event.date}</time><span class="evidence-tag">{event.type}</span></div><div class="event-copy"><h3>{event.title}</h3><p>{event.body}</p><a class="event-source" href={source(event.sourceId).url} target="_blank" rel="noopener noreferrer">{source(event.sourceId).label} · {source(event.sourceId).publisher} <span aria-hidden="true">↗</span></a></div></article>)}</div>
                  )}

                  {scene.reviews && <div class="review-grid">{scene.reviews.map(review => <article class="review-card"><time>{review.date}</time><h3>{review.title}</h3><p class="review-value">{review.value}</p><p>{review.body}</p><p class="review-caveat">{review.caveat}</p><a class="event-source" href={source(review.sourceId).url} target="_blank" rel="noopener noreferrer">{source(review.sourceId).label} · 리뷰 원문 ↗</a></article>)}</div>}

                  {scene.verdict && <aside class="verdict" data-tone={scene.verdict.tone}><span class="verdict-label">이 페이지의 판단 <span aria-hidden="true">/</span> {scene.verdict.label}</span><p>{scene.verdict.body}</p></aside>}

                  {timeline && <div class="future-timeline"><p class="future-notice"><span class="evidence-tag future-tag">미래 · 미검증</span>원래 시나리오의 순서 <span>관찰할 항목은 편집 제안</span></p>{timeline.map(item => <article class="future-event"><time>{item.date}</time><div><h3>{item.title}</h3><p>{item.body} <a class="source-cite" href={source(item.sourceId).url} target="_blank" rel="noopener noreferrer" aria-label={`${item.date} 시나리오 원문`}>[{source(item.sourceId).label}] ↗</a></p><p class="watch-for"><span>다음에 확인할 것</span>{item.watch}</p></div></article>)}</div>}

                  {scene.showBranches && <div class="branch-grid">{report.branches.map(branch => <article class="branch" data-tone={branch.tone}><div class="branch-top"><span>{branch.name}</span><span>{branch.en}</span></div><h3>{branch.title}</h3><p>{branch.body}</p><a class="event-source" href={source(branch.sourceId).url} target="_blank" rel="noopener noreferrer">{source(branch.sourceId).label} · 결말 원문 ↗</a><p class="branch-question">{branch.question}</p></article>)}</div>}

                  {scene.showDiscussion && <div class="discussion-list">{report.discussion.map(item => <article class="discussion"><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.body}</p><details><summary>한 번 더 묻기</summary><p>{item.followUp}</p></details></div></article>)}</div>}

                  {scene.details?.map(detail => <details class="context-panel"><summary>{detail.title}<span aria-hidden="true">＋</span></summary><div>{detail.body.map(paragraph => <p>{paragraph}</p>)}<div class="context-sources">{detail.sourceIds.map(id => <a href={source(id).url} target="_blank" rel="noopener noreferrer">{source(id).label} · {source(id).publisher} ↗</a>)}</div></div></details>)}

                  {scene.showSources && <><div class="source-method">{report.sourceNotes.map((note, index) => <p><span>0{index + 1}</span>{note}</p>)}</div><ol class="source-list">{report.sources.map(item => <li id={`source-${item.id}`}><span class="source-label">{item.label}</span><div><div class="source-meta"><span>{item.kind}</span><time>{item.date}</time></div><h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <span aria-hidden="true">↗</span></a></h3><p class="source-publisher">{item.publisher}</p><p>{item.note}</p></div></li>)}</ol><p class="source-cutoff">검토 기준일 {report.meta.reviewed} · 출처의 이후 수정 내용은 이 페이지에 자동 반영되지 않습니다.</p></>}

                  {scene.question && <aside class="conversation"><span class="small-label">같이 이야기할 질문</span><p>{scene.question}</p></aside>}
                  {scene.hostNote && <details class="host-note"><summary>진행 메모 펼치기</summary><p>{scene.hostNote}</p></details>}
                </section>
              );
            })}
          </div>

          <nav class="deck-pagination" aria-label="이전 다음 장면" data-controls><button type="button" data-prev><span aria-hidden="true">←</span> 이전 장면</button><p data-next-label>다음 · {scenes[1].nav}</p><button type="button" data-next>다음 장면 <span aria-hidden="true">→</span></button></nav>
          <div class="stage-footer"><a href="/knowledge/">← Knowledge로 돌아가기</a><span>AI 2027 / {report.meta.reviewed}</span></div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<script>
  const article = document.querySelector<HTMLElement>('[data-ai-2027]');
  if (article) {
    const panels = Array.from(article.querySelectorAll<HTMLElement>('[data-scene]'));
    const links = Array.from(article.querySelectorAll<HTMLAnchorElement>('[data-scene-link]'));
    const nav = article.querySelector<HTMLElement>('.scene-nav')!;
    const deck = article.querySelector<HTMLElement>('.deck')!;
    const prev = article.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = article.querySelector<HTMLButtonElement>('[data-next]')!;
    const all = article.querySelector<HTMLButtonElement>('[data-read-all]')!;
    let active = 0;
    let readAll = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const indexFromHash = () => {
      let id = '';
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return -1; }
      return panels.findIndex(panel => panel.id === id || panel.querySelector(`[id="${CSS.escape(id)}"]`));
    };
    const render = () => {
      article.dataset.view = readAll ? 'all' : 'scenes';
      nav.setAttribute('role', readAll ? 'navigation' : 'tablist');
      if (readAll) nav.removeAttribute('aria-orientation');
      else nav.setAttribute('aria-orientation', matchMedia('(max-width: 980px)').matches ? 'horizontal' : 'vertical');
      panels.forEach((panel, i) => {
        const wasHidden = panel.hidden;
        panel.hidden = !readAll && i !== active;
        panel.setAttribute('role', readAll ? 'region' : 'tabpanel');
        panel.setAttribute('aria-labelledby', readAll ? `heading-${panel.id}` : `tab-${panel.id}`);
        // Reload only a newly hidden player, so audio cannot continue in another scene.
        if (!wasHidden && panel.hidden) panel.querySelectorAll<HTMLIFrameElement>('iframe').forEach(frame => { frame.src = frame.src; });
      });
      links.forEach((link, i) => {
        link.classList.toggle('is-active', i === active);
        if (readAll) {
          link.removeAttribute('role'); link.removeAttribute('aria-selected'); link.removeAttribute('tabindex');
          if (i === active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
        } else {
          link.setAttribute('role', 'tab'); link.setAttribute('aria-selected', String(i === active));
          link.setAttribute('tabindex', i === active ? '0' : '-1'); link.removeAttribute('aria-current');
        }
      });
      article.querySelector('[data-current]')!.textContent = String(active + 1).padStart(2, '0');
      article.querySelector('[data-current-label]')!.textContent = links[active].querySelectorAll('span')[1].textContent;
      prev.disabled = active === 0; next.disabled = active === panels.length - 1;
      article.querySelector('[data-next-label]')!.textContent = active < panels.length - 1 ? `다음 · ${links[active + 1].querySelectorAll('span')[1].textContent}` : '모든 장면을 살펴봤습니다.';
      all.textContent = readAll ? '장면별 보기' : '전체 읽기';
      all.setAttribute('aria-pressed', String(readAll));
    };
    const select = (index: number, options: { history?: boolean; focus?: boolean; scroll?: boolean } = {}) => {
      if (index < 0 || index >= panels.length) return;
      active = index; render();
      if (options.history && location.hash !== `#${panels[active].id}`) history.pushState(null, '', `#${panels[active].id}`);
      if (options.focus) links[active].focus({ preventScroll: true });
      if (options.scroll) (readAll ? panels[active] : deck).scrollIntoView({ block: 'start', behavior: reduceMotion.matches ? 'instant' : 'smooth' });
      // Keep the selected mobile tab in view without scrolling the page vertically.
      const selected = links[active];
      if (matchMedia('(max-width: 980px)').matches) nav.scrollTo({ left: selected.offsetLeft - nav.offsetLeft - 12, behavior: reduceMotion.matches ? 'instant' : 'smooth' });
    };
    const onHash = () => { const index = indexFromHash(); if (index >= 0) select(index); };
    article.dataset.enhanced = 'true';
    active = Math.max(0, indexFromHash()); render();
    links.forEach((link, i) => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); select(i, { history: true, scroll: true });
    }));
    // Ordinary in-page links (hero and source desk) also open the correct panel.
    article.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not([data-scene-link])').forEach(link => link.addEventListener('click', event => {
      const index = panels.findIndex(panel => `#${panel.id}` === link.hash);
      if (index < 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); select(index, { history: true, scroll: true });
    }));
    prev.addEventListener('click', () => select(active - 1, { history: true, scroll: true }));
    next.addEventListener('click', () => select(active + 1, { history: true, scroll: true }));
    all.addEventListener('click', () => { readAll = !readAll; render(); if (!readAll) deck.scrollIntoView({ block: 'start' }); });
    article.querySelector('[data-print]')!.addEventListener('click', () => window.print());
    document.addEventListener('keydown', event => {
      if (readAll || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const target = event.target as HTMLElement;
      const onTab = target.matches('[data-scene-link]');
      const onPager = target.matches('[data-prev], [data-next]');
      if (!onTab && !onPager && target.closest('a, button, input, textarea, select, summary, details, [contenteditable="true"]')) return;
      let index = active;
      if (event.key === 'ArrowRight' || (onTab && event.key === 'ArrowDown')) index++;
      else if (event.key === 'ArrowLeft' || (onTab && event.key === 'ArrowUp')) index--;
      else if (onTab && event.key === 'Home') index = 0;
      else if (onTab && event.key === 'End') index = panels.length - 1;
      else return;
      event.preventDefault(); select(Math.max(0, Math.min(panels.length - 1, index)), { history: true, focus: true, scroll: true });
    });
    window.addEventListener('hashchange', onHash);
    window.addEventListener('popstate', () => select(Math.max(0, indexFromHash())));
    window.addEventListener('resize', () => { if (!readAll) nav.setAttribute('aria-orientation', matchMedia('(max-width: 980px)').matches ? 'horizontal' : 'vertical'); });
    // Include every scene and expanded source context in printed copies.
    let openedForPrint: HTMLDetailsElement[] = [];
    window.addEventListener('beforeprint', () => { openedForPrint = Array.from(article.querySelectorAll<HTMLDetailsElement>('details:not([open]):not(.report-embed)')); openedForPrint.forEach(detail => { detail.open = true; }); });
    window.addEventListener('afterprint', () => { openedForPrint.forEach(detail => { detail.open = false; }); openedForPrint = []; });
    if (location.hash) requestAnimationFrame(() => panels[active].scrollIntoView({ block: 'start' }));
  }
</script>

<style>
  .a27 { --ink: #f5f0eb; --muted: #aaa3a9; --line: #ffffff20; --paper: #160f18; --accent: #fd9a63; --green: #8ed5bd; --blue: #a9c7f3; color: var(--ink); background: radial-gradient(ellipse at 80% 10%, #2d152330, transparent 50%); }
  .dossier-shell { max-width: 1480px; margin: 0 auto; padding: 2.2rem 4.2rem 4rem; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }
  :is(a, button, summary, [tabindex]):focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  button { font: inherit; cursor: pointer; }
  .breadcrumb { display: flex; gap: .8rem; color: var(--muted); font-size: .78rem; }
  .breadcrumb span:last-child { color: #e1d5dc; }
  .dossier-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 5.5rem; align-items: center; padding: 3.5rem 0 3.7rem; }
  .eyebrow, .small-label, .desk-top, .rail-heading, .group-label, .comparison-label, .source-label, .stage-footer { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .eyebrow { display: flex; align-items: center; gap: .65rem; color: var(--accent); font-size: .68rem; letter-spacing: .09em; line-height: 1.6; }
  .status-light { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .report-wordmark { margin: 1.5rem 0 1rem; font-size: clamp(3.6rem, 7.7vw, 7rem); font-weight: 760; line-height: 1; letter-spacing: -.08em; white-space: nowrap; }
