---
import Layout from '../../../layouts/Layout.astro';
import KnowledgeSidebar from '../../../components/KnowledgeSidebar.astro';
import GraphView from '../../../components/GraphView.astro';
import DocumentPanel from '../../../components/DocumentPanel.astro';
import { getCollection } from 'astro:content';
import { generateGraphData } from '../../../utils/graphData';

const locale = 'ko';

// Get all knowledge content for Korean
const allKnowledge = await getCollection('knowledge', ({ slug }) => slug.startsWith('ko/'));

// Filter to only actual content (not category index pages)
const contentItems = allKnowledge.filter(item => {
  const segments = item.slug.split('/');
  return segments.length >= 3;
});

// Generate graph data with additional node info for panel
const graphData = generateGraphData(contentItems, locale);

// Enhance nodes with description and tags for panel display
const enhancedNodes = graphData.nodes.map(node => {
  const contentItem = contentItems.find(item => `doc-${item.slug}` === node.id);
  return {
    ...node,
    description: contentItem?.data.description || '',
    tags: contentItem?.data.tags || [],
  };
});

const enhancedGraphData = {
  nodes: enhancedNodes,
  links: graphData.links,
};

// Categories for filter chips
const categories = [
  { id: 'essays', name: '에세이', color: 'yellow' },
  { id: 'models', name: '모델', color: 'blue' },
  { id: 'companies', name: '기업', color: 'green' },
  { id: 'hardware', name: '하드웨어', color: 'purple' },
  { id: 'people', name: '인물', color: 'pink' },
];

// Total counts
const totalDocs = contentItems.length;
---

<Layout title="색인 | Physical AI" locale={locale}>
  <div class="browse-layout">
    <KnowledgeSidebar locale={locale} activePage="browse" />

    <!-- Main Content: Graph + Panel -->
    <main class="browse-main">
      <!-- Header with Search & Filters -->
      <header class="browse-header">
        <div class="header-top">
          <div class="header-info">
            <h1 class="browse-title">그래프 탐색</h1>
            <p class="browse-subtitle">{totalDocs}개 문서의 연결 관계를 탐색하세요</p>
          </div>
        </div>

        <div class="filters-row">
          <div class="search-box">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="searchInput" placeholder="문서 검색..." autocomplete="off" />
            <button id="clearSearch" class="clear-btn" style="display: none;">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="filter-chips">
            <button class="filter-chip active" data-category="all">전체</button>
            {categories.map(cat => (
              <button class={`filter-chip chip-${cat.color}`} data-category={cat.id}>
                {cat.name}
              </button>
            ))}
          </div>
        </div>
      </header>

      <!-- Graph + Panel Container -->
      <div class="content-area">
        <div class="graph-area" id="graphArea">
          <GraphView
            graphData={enhancedGraphData}
            height="100%"
            locale={locale}
            mode="select"
            showLegend={true}
            showControls={true}
          />
        </div>

        <DocumentPanel locale={locale} />
      </div>
    </main>
  </div>
</Layout>

<script define:vars={{ enhancedGraphData }}>
  // Full graph data for filtering
  const fullGraphData = enhancedGraphData;

  // Current filter state
  let currentCategory = 'all';
  let currentSearch = '';

  // Get graph instance
  const getGraphInstance = () => {
    const container = document.querySelector('[id^="graph-"]');
    return container?._graphInstance;
  };

  // Get highlighted node IDs based on current filters (returns empty set if no filter = all highlighted)
  function getHighlightedNodeIds() {
    // No filters active = return empty set (means all nodes highlighted)
    if (currentCategory === 'all' && !currentSearch) {
      return new Set();
    }

    let filteredNodes = fullGraphData.nodes;

    // Filter by category
    if (currentCategory !== 'all') {
      filteredNodes = filteredNodes.filter(node => node.category === currentCategory);
    }

    // Filter by search
    if (currentSearch) {
      const query = currentSearch.toLowerCase();
      filteredNodes = filteredNodes.filter(node =>
        node.label.toLowerCase().includes(query) ||
        (node.description && node.description.toLowerCase().includes(query)) ||
        (node.tags && node.tags.some(tag => tag.toLowerCase().includes(query)))
      );
    }

    return new Set(filteredNodes.map(n => n.id));
  }

  // Apply filter (highlight matching nodes, dim others)
  function applyFilter() {
    const graph = getGraphInstance();
    if (graph) {
      const highlightedIds = getHighlightedNodeIds();
      graph.setFilterHighlight(highlightedIds);
    }
  }

  // Search input
  const searchInput = document.getElementById('searchInput');
  const clearSearch = document.getElementById('clearSearch');

  let searchTimeout;
  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    clearSearch.style.display = query ? 'flex' : 'none';

    // Debounce
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      currentSearch = query;
      applyFilter();
    }, 300);
  });

  clearSearch?.addEventListener('click', () => {
    searchInput.value = '';
    clearSearch.style.display = 'none';
    currentSearch = '';
    applyFilter();
  });

  // Category filter - reset selection and search, then apply category
  const filterChips = document.querySelectorAll('.filter-chip');
  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      filterChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentCategory = chip.getAttribute('data-category') || 'all';

      // Clear search
      if (searchInput) {
        searchInput.value = '';
        clearSearch.style.display = 'none';
      }
      currentSearch = '';

      // Reset graph view and clear node selection
      const graph = getGraphInstance();
      if (graph) {
        graph.resetView();
      }

      // Clear panel selection by dispatching empty select event
      document.dispatchEvent(new CustomEvent('graph:node-select', {
        detail: { node: null, connectedNodes: [] }
      }));

      // Apply category filter
      applyFilter();
    });
  });

  // Tag filter from panel - reset everything first, then apply tag search
  document.addEventListener('panel:filter-tag', ((e) => {
    const tag = e.detail.tag;
    if (tag && searchInput) {
      // Reset category to 'all'
      filterChips.forEach(c => c.classList.remove('active'));
      document.querySelector('.filter-chip[data-category="all"]')?.classList.add('active');
      currentCategory = 'all';

      // Reset graph view first
      const graph = getGraphInstance();
      if (graph) {
        graph.clearFilterHighlight();
        graph.resetView();
      }

      // Then apply tag search
      searchInput.value = tag;
      clearSearch.style.display = 'flex';
      currentSearch = tag;
      applyFilter();
    }
  }));

  // Focus node from panel - reset everything first, then focus and update panel
  document.addEventListener('panel:focus-node', ((e) => {
    const nodeId = e.detail.nodeId;
    if (nodeId) {
      // Reset category to 'all'
      filterChips.forEach(c => c.classList.remove('active'));
      document.querySelector('.filter-chip[data-category="all"]')?.classList.add('active');
      currentCategory = 'all';

      // Clear search
      if (searchInput) {
        searchInput.value = '';
        clearSearch.style.display = 'none';
      }
      currentSearch = '';

      // Reset filter highlight and focus on node
      const graph = getGraphInstance();
      if (graph) {
        graph.clearFilterHighlight();
        graph.focusNode(nodeId);
      }

      // Find node data and update panel
      const node = fullGraphData.nodes.find(n => n.id === nodeId);
      if (node) {
        // Get connected nodes
        const connectedIds = new Set([nodeId]);
        fullGraphData.links.forEach(link => {
          const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
          const targetId = typeof link.target === 'object' ? link.target.id : link.target;
          if (sourceId === nodeId) connectedIds.add(targetId);
          if (targetId === nodeId) connectedIds.add(sourceId);
        });
        const connectedNodes = fullGraphData.nodes.filter(n => connectedIds.has(n.id));

        // Dispatch event to update panel
        document.dispatchEvent(new CustomEvent('graph:node-select', {
          detail: { node, connectedNodes }
        }));
      }
    }
  }));

</script>

<style>
  .browse-layout {
    display: grid;
    grid-template-columns: 1fr;
    min-height: calc(100vh - 64px);
  }

  @media (min-width: 1024px) {
    .browse-layout {
      grid-template-columns: 260px 1fr;
    }
  }

  /* Main Content */
  .browse-main {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 64px);
  }

  .browse-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-primary);
  }

  .header-top {
    margin-bottom: 1rem;
  }

  .browse-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .browse-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0;
  }

  .filters-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .filters-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    flex: 1;
    max-width: 300px;
  }

  .search-box svg { color: var(--color-text-muted); }

  .search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-size: 0.875rem;
  }

  .search-box input::placeholder { color: var(--color-text-muted); }

  .clear-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .clear-btn:hover { color: var(--color-text-primary); }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .filter-chip {
    padding: 0.375rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-chip:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text-primary);
  }

  .filter-chip.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .filter-chip.chip-yellow.active { background: #eab308; border-color: #eab308; }
  .filter-chip.chip-blue.active { background: #3b82f6; border-color: #3b82f6; }
  .filter-chip.chip-green.active { background: #10b981; border-color: #10b981; }
  .filter-chip.chip-purple.active { background: #a78bfa; border-color: #a78bfa; }
  .filter-chip.chip-pink.active { background: #f472b6; border-color: #f472b6; }

  /* Content Area: Graph + Panel */
  .content-area {
    display: grid;
    grid-template-columns: 1fr;
    flex: 1;
    min-height: 0;
  }

  @media (min-width: 1024px) {
    .content-area {
      grid-template-columns: 1fr 320px;
    }
  }

  @media (min-width: 1280px) {
    .content-area {
      grid-template-columns: 1fr 360px;
    }
  }

  .graph-area {
    height: calc(100vh - 64px - 140px);
    min-height: 400px;
  }

  @media (min-width: 1024px) {
    .graph-area {
      height: auto;
    }
  }
</style>
