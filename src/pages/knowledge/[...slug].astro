---
import Layout from '../../layouts/Layout.astro';
import KnowledgeSidebar from '../../components/KnowledgeSidebar.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const locale = 'ko';
const { t } = useTranslations(locale);

export async function getStaticPaths() {
  const entries = await getCollection('knowledge', ({ slug }) => slug.startsWith('ko/'));
  return entries.map((entry) => ({
    params: { slug: entry.slug.replace('ko/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Get all content for related docs resolution
const allKnowledge = await getCollection('knowledge', ({ slug }) => slug.startsWith('ko/'));

// Get current slug for highlighting
const currentSlug = entry.slug.replace('ko/', '');
const currentCategory = entry.data.category;

// Determine current subcategory if applicable
let currentSubcategory = null;
const slugParts = entry.slug.split('/');
if ((currentCategory === 'hardware' || currentCategory === 'essays') && slugParts.length >= 4) {
  currentSubcategory = slugParts[2];
}

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Get related documents for See Also section
const relatedDocs = (entry.data.related || []).map(relatedSlug => {
  // Remove .md extension if present
  const cleanSlug = relatedSlug.replace(/\.md$/, '');

  // Get the current document's folder path (e.g., 'ko/essays/fundamentals' from 'ko/essays/fundamentals/definition')
  const currentSlugParts = entry.slug.split('/');
  currentSlugParts.pop(); // Remove the filename
  const folderPath = currentSlugParts.join('/');

  let matchedDoc = null;

  // 1. Handle relative paths (e.g., ../insights/simulation-world-model)
  if (cleanSlug.startsWith('../') || cleanSlug.startsWith('./')) {
    const parts = folderPath.split('/');
    const relParts = cleanSlug.split('/');

    for (const part of relParts) {
      if (part === '..') {
        parts.pop();
      } else if (part !== '.') {
        parts.push(part);
      }
    }
    const resolvedSlug = parts.join('/');
    matchedDoc = allKnowledge.find(item => item.slug === resolvedSlug);
  }

  // 2. Handle cross-category paths (e.g., models/xxx, companies/xxx)
  if (!matchedDoc && cleanSlug.includes('/')) {
    const fullSlug = `ko/${cleanSlug}`;
    matchedDoc = allKnowledge.find(item => item.slug === fullSlug);
  }

  // 3. Try same folder first
  if (!matchedDoc) {
    const fullSlug = `${folderPath}/${cleanSlug}`;
    matchedDoc = allKnowledge.find(item => item.slug === fullSlug);
  }

  // 4. Try sibling folders (e.g., fundamentals -> insights or vice versa for essays)
  if (!matchedDoc) {
    const parentParts = folderPath.split('/');
    parentParts.pop(); // Remove current subfolder (e.g., 'fundamentals')
    const parentPath = parentParts.join('/');

    // Search in all sibling subfolders
    matchedDoc = allKnowledge.find(item => {
      const itemParts = item.slug.split('/');
      const itemName = itemParts.pop();
      const itemParent = itemParts.slice(0, -1).join('/');
      return itemParent === parentPath && itemName === cleanSlug;
    });
  }

  // 5. Search anywhere in the knowledge base by filename
  if (!matchedDoc) {
    matchedDoc = allKnowledge.find(item => {
      const itemName = item.slug.split('/').pop();
      return itemName === cleanSlug;
    });
  }

  if (matchedDoc) {
    return {
      title: matchedDoc.data.title,
      url: `/knowledge/${matchedDoc.slug.replace('ko/', '')}`,
      category: matchedDoc.data.category,
    };
  }
  return null;
}).filter(Boolean);

// Category colors
const categoryColors: Record<string, string> = {
  'models': 'blue',
  'companies': 'green',
  'hardware': 'purple',
  'essays': 'yellow',
  'people': 'pink',
};

const categoryNames: Record<string, string> = {
  'models': '모델',
  'companies': '기업',
  'hardware': '하드웨어',
  'essays': '에세이',
  'people': '인물',
};
---

<Layout title={entry.data.title} locale={locale}>
  <div class="doc-layout">
    <KnowledgeSidebar
      locale={locale}
      currentSlug={currentSlug}
      currentCategory={currentCategory}
      currentSubcategory={currentSubcategory}
      activePage="content"
    />

    <!-- Main Content -->
    <main class="doc-main">
      <div class="doc-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
          <a href="/knowledge">지식 창고</a>
          <span class="separator">/</span>
          <a href="/knowledge/physical-ai">Physical AI</a>
          <span class="separator">/</span>
          <a href="/knowledge/physical-ai" class={`category-link color-${categoryColors[entry.data.category]}`}>
            {categoryNames[entry.data.category]}
          </a>
          <span class="separator">/</span>
          <span class="current">{entry.data.title}</span>
        </nav>

        <!-- Article -->
        <article class="article">
          <header class="article-header">
            <h1 class="article-title">{entry.data.title}</h1>
            <p class="article-description">{entry.data.description}</p>
          </header>

          <div class="article-content prose">
            <Content />
          </div>

          {/* See Also Section */}
          {relatedDocs.length > 0 && (
            <section class="see-also">
              <h3 class="see-also-title">See Also</h3>
              <ul class="see-also-list">
                {relatedDocs.map((doc) => (
                  <li>
                    <a href={doc.url} class={`see-also-link color-${categoryColors[doc.category]}`}>
                      {doc.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <footer class="article-footer">
            {/* Authorship info */}
            {(entry.data.createdBy || entry.data.lastEditedBy) && (
              <div class="authorship-info">
                {entry.data.createdBy && (
                  <div class="author-item">
                    <span class="author-label">작성</span>
                    <span class="author-name">
                      {entry.data.createdBy.email ? (
                        <a href={`mailto:${entry.data.createdBy.email}`}>{entry.data.createdBy.name}</a>
                      ) : (
                        entry.data.createdBy.name
                      )}
                    </span>
                  </div>
                )}
                {entry.data.lastEditedBy && entry.data.lastEditedAt && (
                  <div class="author-item">
                    <span class="author-label">최종 수정</span>
                    <span class="author-name">
                      {entry.data.lastEditedBy.email ? (
                        <a href={`mailto:${entry.data.lastEditedBy.email}`}>{entry.data.lastEditedBy.name}</a>
                      ) : (
                        entry.data.lastEditedBy.name
                      )}
                    </span>
                    <span class="author-date">
                      {entry.data.lastEditedAt.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                  </div>
                )}
              </div>
            )}

            <a href="/knowledge/physical-ai" class="back-link">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              목록으로 돌아가기
            </a>
          </footer>
        </article>
      </div>
    </main>

    <!-- Right Sidebar: Table of Contents -->
    {tocHeadings.length > 0 && (
      <aside class="sidebar-right">
        <div class="toc">
          <h4 class="toc-title">목차</h4>
          <nav class="toc-nav">
            {tocHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class={`toc-link depth-${heading.depth}`}
                data-heading={heading.slug}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>
</Layout>

<script>
  // Table of contents scroll spy
  const tocLinks = document.querySelectorAll('.toc-link');
  const headings = document.querySelectorAll('.article-content h2, .article-content h3');

  function updateActiveHeading() {
    const scrollPos = window.scrollY + 100;

    let currentHeading = '';
    headings.forEach((heading) => {
      if ((heading as HTMLElement).offsetTop <= scrollPos) {
        currentHeading = heading.id;
      }
    });

    tocLinks.forEach((link) => {
      link.classList.remove('active');
      if (link.getAttribute('data-heading') === currentHeading) {
        link.classList.add('active');
      }
    });
  }

  window.addEventListener('scroll', updateActiveHeading);
  updateActiveHeading();
</script>

<style>
  .doc-layout {
    display: grid;
    grid-template-columns: 1fr;
    min-height: calc(100vh - 64px);
  }

  @media (min-width: 1024px) {
    .doc-layout {
      grid-template-columns: 280px 1fr 200px;
    }
  }

  @media (min-width: 1280px) {
    .doc-layout {
      grid-template-columns: 300px 1fr 240px;
    }
  }

  /* Main Content */
  .doc-main {
    min-width: 0;
  }

  .doc-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  @media (min-width: 1024px) {
    .doc-container {
      padding: 2rem 2rem 4rem;
    }
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-text-primary);
  }

  .category-link.color-blue:hover { color: var(--color-blue); }
  .category-link.color-green:hover { color: var(--color-green); }
  .category-link.color-purple:hover { color: #a78bfa; }
  .category-link.color-yellow:hover { color: var(--color-yellow); }
  .category-link.color-pink:hover { color: #f472b6; }

  .separator {
    color: var(--color-border);
  }

  .current {
    color: var(--color-text-secondary);
  }

  /* Article */
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .article-description {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Article Content */
  .article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style-type: disc;
  }

  .article-content :global(ol) {
    list-style-type: decimal;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    display: list-item;
  }

  .article-content :global(li::marker) {
    color: var(--color-accent);
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .article-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Author's Note - Special comment box */
  .article-content :global(.author-note) {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin: 0 0 2rem 0;
  }

  .article-content :global(.author-note h3) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 0.75rem 0;
    padding: 0;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-content :global(.author-note ul),
  .article-content :global(.author-note ol) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .article-content :global(.author-note li) {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.375rem;
  }

  .article-content :global(.author-note li:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }

  .article-content :global(pre) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--color-text-secondary);
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .article-content :global(th),
  .article-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    text-align: left;
  }

  .article-content :global(th) {
    background: var(--color-bg-secondary);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .article-content :global(td) {
    color: var(--color-text-secondary);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: 1.5rem 0;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  /* See Also Section */
  .see-also {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .see-also-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .see-also-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .see-also-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .see-also-link::before {
    content: '→';
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .see-also-link:hover {
    color: var(--color-accent);
  }

  .see-also-link:hover::before {
    color: var(--color-accent);
  }

  .see-also-link.color-blue:hover { color: var(--color-blue); }
  .see-also-link.color-blue:hover::before { color: var(--color-blue); }
  .see-also-link.color-green:hover { color: var(--color-green); }
  .see-also-link.color-green:hover::before { color: var(--color-green); }
  .see-also-link.color-purple:hover { color: #a78bfa; }
  .see-also-link.color-purple:hover::before { color: #a78bfa; }
  .see-also-link.color-yellow:hover { color: var(--color-yellow); }
  .see-also-link.color-yellow:hover::before { color: var(--color-yellow); }
  .see-also-link.color-pink:hover { color: #f472b6; }
  .see-also-link.color-pink:hover::before { color: #f472b6; }

  /* Footer */
  .article-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  /* Authorship Info */
  .authorship-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8rem;
  }

  .author-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-label {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .author-name {
    color: var(--color-text-secondary);
  }

  .author-name a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .author-name a:hover {
    color: var(--color-accent);
  }

  .author-date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Right Sidebar: TOC */
  .sidebar-right {
    display: none;
  }

  @media (min-width: 1024px) {
    .sidebar-right {
      display: block;
      position: sticky;
      top: 64px;
      height: calc(100vh - 64px);
      overflow-y: auto;
      padding: 2rem 1rem 2rem 0;
    }
  }

  .toc {
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-link {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.15s;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
  }

  .toc-link.active {
    color: var(--color-accent);
  }

  .toc-link.depth-3 {
    padding-left: 0.75rem;
    font-size: 0.75rem;
  }
</style>
