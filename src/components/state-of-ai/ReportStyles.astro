  .soai .report-facts dd > span { font-size: 10px; letter-spacing: 0; color: var(--report-muted); }
  .soai .report-facts dd.fact-author { font-family: var(--font-sans); font-size: 14px; letter-spacing: 0; }
  .soai .fact-author span { display: block; margin-top: 3px; }
