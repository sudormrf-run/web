<style is:global>
  .soai {
    --report-bg: #101110;
    --report-panel: #181a18;
    --report-line: #343730;
    --report-muted: #a8ada4;
    --report-ink: #f4f4ed;
    --report-orange: #ff7b36;
    background: var(--report-bg);
    color: var(--report-ink);
    overflow-wrap: break-word;
  }
  .soai *, .soai *::before, .soai *::after { box-sizing: border-box; }
  .soai a { color: inherit; }
  .soai a:hover { color: var(--report-orange); }
  .soai button, .soai input, .soai select { font: inherit; }
  .soai button, .soai summary { cursor: pointer; }
  .soai [hidden] { display: none !important; }
  .soai .report-shell { max-width: 1264px; margin-inline: auto; padding-inline: 40px; }
  .soai .report-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding-block: 32px; font-size: 12px; color: var(--report-muted); }
  .soai .report-breadcrumb a:first-child { color: var(--report-orange); }
  .soai .report-breadcrumb > span[aria-hidden] { color: #666b61; }
  .soai .report-eyebrow { color: var(--report-orange); font-family: var(--font-mono); font-size: 11px; line-height: 1.6; font-weight: 500; letter-spacing: .1em; }
  .soai .status-dot { width: 7px; height: 7px; margin-right: 8px; display: inline-block; border-radius: 50%; background: var(--report-orange); vertical-align: 1px; }
  .soai .report-hero { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 68px; align-items: center; padding: 38px 0 64px; }
  .soai .hero-copy h1 { font-size: clamp(48px, 6vw, 78px); font-weight: 700; letter-spacing: -.065em; line-height: 1.03; margin-top: 25px; }
  .soai .hero-year { display: block; font-size: clamp(100px, 13vw, 166px); line-height: .99; margin-left: -7px; letter-spacing: -.09em; font-weight: 800; }
  .soai .year-dot { color: var(--report-orange); }
  .soai .hero-subtitle { max-width: 640px; margin-top: 28px; color: #c7cbc1; font-size: 17px; line-height: 1.85; word-break: keep-all; }
  .soai .report-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 30px; }
  .soai .report-button { display: inline-flex; justify-content: center; align-items: center; gap: 22px; background: transparent; border: 1px solid #4b5047; border-radius: 3px; padding: 13px 17px; font-size: 13px; font-weight: 600; color: var(--report-ink); text-align: center; transition: background .15s, border-color .15s; }
  .soai .report-button:hover { border-color: var(--report-orange); color: var(--report-orange); }
  .soai .report-button.primary { color: #171910; background: var(--report-orange); border-color: var(--report-orange); }
  .soai .report-button.primary:hover { background: #ff935d; border-color: #ff935d; color: #171910; }
  .soai .hero-index { border: 1px solid #484b42; border-top: 3px solid var(--report-orange); background: #171915; padding: 20px 24px; transform: rotate(1.3deg); }
  .soai .index-topline { display: flex; justify-content: space-between; gap: 10px; color: var(--report-muted); font-family: var(--font-mono); font-size: 9px; letter-spacing: .075em; }
  .soai .index-mark { display: flex; align-items: center; justify-content: space-between; color: #eff0e5; font-size: 100px; font-weight: 800; letter-spacing: -.1em; line-height: 1.6; }
  .soai .index-mark > span { font-size: 91px; color: var(--report-orange); font-weight: 400; transform: translateY(-5px); }
  .soai .report-cover { display: block; width: 100%; height: auto; margin-block: 18px; }
