  .soai .index-sections a { display: grid; grid-template-columns: 27px 1fr auto; align-items: center; gap: 10px; border-bottom: 1px solid var(--report-line); padding: 10px 0; font-size: 12px; }
  .soai .index-number { font-family: var(--font-mono); font-size: 10px; color: var(--report-orange); }
  .soai .index-pages { font-family: var(--font-mono); font-size: 10px; color: var(--report-muted); }
  .soai .index-source { display: flex; align-items: center; justify-content: space-between; margin-top: 17px; color: var(--report-muted); font-size: 11px; }
