<style is:global>
  .vlab { --vl-bg: #111613; --vl-panel: #181f1a; --vl-line: #354139; --vl-ink: #edf2e9; --vl-muted: #aab8ad; --vl-accent: #a4efc1; --vl-orange: #ff9254; color: var(--vl-ink); background: var(--vl-bg); overflow-wrap: anywhere; }
